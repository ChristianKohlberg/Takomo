{
  "name": "@takomo/web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Takomo's browser surfaces. Builds twice from one source: four self-contained pages the Rust binary serves, and a component library the design system consumes.",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "style": "./dist-lib/index.css",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./styles.css": "./dist-lib/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "size": "node scripts/check-size.mjs",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-code-block": "^3.30.2",
    "@tiptap/extension-collaboration": "^3.30.2",
    "@tiptap/extension-collaboration-caret": "^3.30.2",
    "@tiptap/extension-table": "3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lib0": "^0.2.117",
    "lucide-react": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
