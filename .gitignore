/target
*.db
*.db-wal
*.db-shm

# Takomo agent token (secret) — config is committed, token is not
.takomo/token

# `claude mcp add --scope project` writes a bearer token in plaintext here
.mcp.json

# Claude Code's isolated agent worktrees — real git worktrees of this repo, so
# they must never be tracked (and untracked they make tooling that hashes the
# working tree complain).
.claude/worktrees/

# design-sync: staged converter scripts, generated bundle, machine state.
# The durable set under .design-sync/ (config.json, NOTES.md, conventions.md,
# previews/, overrides/) IS committed — verification state is not.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Local tool output, regenerable and machine-specific.
#
# Both were untracked AND unignored, which is the combination that bites: they
# do not show up as a diff to review, but `git add -A` sweeps them into whatever
# commit is being made next. Ignoring them is what makes `add -A` safe again.
# `.handrail/` needed no entry — it held nothing but cached gate results and was
# removed rather than ignored.
.lavish/
test-results/
