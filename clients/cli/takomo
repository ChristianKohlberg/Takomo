# Read a project field out of GET /v1/projects (the authoritative list).
project_field() {
  api GET /v1/projects >/dev/null
  python3 - "$REQ_OUT" "$1" "$2" <<'PY'
import json, sys
rows, pid, field = json.load(open(sys.argv[1])), sys.argv[2], sys.argv[3]
for p in rows:
    if p.get("id") == pid:
        print(p.get(field) or "")
        sys.exit(0)
sys.stderr.write(f"no project '{pid}' visible to this token\n")
sys.exit(2)
PY
}

# takomo project style PROJECT ["text" | --file PATH | --clear] — the project's
# house style for the text agents write (ticket titles/bodies, comments, and
# ask-a-human questions). With no value, prints the current guide. Advisory: the
# store surfaces it to agents as `style_hint`, it never rejects anything.
cmd_project_style() {
  local id="" text="" file="" clear="" have=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --clear) clear=1; have=1; shift ;;
      --file) file=$2; have=1; shift 2 ;;
      -*) die "project style: unknown flag $1" ;;
      *) if [ -z "$id" ]; then id=$1; else text=$1; have=1; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "project style: PROJECT is required"
  [ -z "$clear" ] || [ -z "$file$text" ] || die "project style: --clear takes no value"

  if [ -z "$have" ]; then
    local cur; cur=$(project_field "$id" style_guide) || exit 1
    if [ -n "$cur" ]; then printf '%s\n' "$cur"; else echo "(no style guide set for $id)"; fi
    return 0
  fi

  if [ -n "$file" ]; then
    if [ "$file" = "-" ]; then text=$(cat); else
      [ -f "$file" ] || die "project style: no such file '$file'"
      text=$(cat "$file")
    fi
  fi

  local data
  if [ -n "$clear" ]; then
    data='{"style_guide":null}'
  else
    data=$(TS_S="$text" python3 -c 'import json,os; print(json.dumps({"style_guide":os.environ["TS_S"]}))')
  fi
  api PUT "/v1/projects/$(urlenc "$id")/style" "$data" >/dev/null
  if [ -n "$clear" ]; then echo "cleared the style guide for $id"; else echo "set the style guide for $id"; fi
}

# takomo project language PROJECT [LANG | --clear] — the human-facing language
# ask-a-human questions should be written in. With no value, prints the current
# setting. Also advisory (surfaced to agents as `language_hint`).
cmd_project_language() {
  local id="" lang="" clear=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --clear) clear=1; shift ;;
      -*) die "project language: unknown flag $1" ;;
      *) if [ -z "$id" ]; then id=$1; else lang=$1; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "project language: PROJECT is required"
  [ -z "$clear" ] || [ -z "$lang" ] || die "project language: --clear takes no value"

  if [ -z "$clear" ] && [ -z "$lang" ]; then
    local cur; cur=$(project_field "$id" question_language) || exit 1
    if [ -n "$cur" ]; then printf '%s\n' "$cur"; else echo "(no question language set for $id)"; fi
    return 0
  fi

  local data
  if [ -n "$clear" ]; then
    data='{"language":null}'
  else
    data=$(TS_L="$lang" python3 -c 'import json,os; print(json.dumps({"language":os.environ["TS_L"]}))')
  fi
  api PUT "/v1/projects/$(urlenc "$id")/language" "$data" >/dev/null
  if [ -n "$clear" ]; then echo "cleared the question language for $id"; else echo "set the question language for $id to $lang"; fi
}

# takomo project answer-ttl PROJECT [7d | --clear] — how long an answer link
# minted for one of this project's questions stays valid. With no value, prints
# the current setting. Unlike style/language this one is ENFORCED: it decides how
# long a credential handed to someone outside the org lives. Max 30d; --clear
# falls back to the built-in default of 7 days.
cmd_project_answer_ttl() {
  local id="" ttl="" clear=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --clear) clear=1; shift ;;
      -*) die "project answer-ttl: unknown flag $1" ;;
      *) if [ -z "$id" ]; then id=$1; else ttl=$1; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "project answer-ttl: PROJECT is required"
  [ -z "$clear" ] || [ -z "$ttl" ] || die "project answer-ttl: --clear takes no value"

  if [ -z "$clear" ] && [ -z "$ttl" ]; then
    local cur; cur=$(project_field "$id" answer_link_ttl_seconds) || exit 1
    if [ -n "$cur" ]; then
      echo "$cur"
    else
      echo "(no answer-link lifetime set for $id; the built-in default of 7 days applies)"
    fi
    return 0
  fi

  local data
  if [ -n "$clear" ]; then
    data='{"ttl_seconds":null}'
  else
    local secs; secs=$(ttl_to_seconds "$ttl") || exit 1
    data=$(TS_T="$secs" python3 -c 'import json,os; print(json.dumps({"ttl_seconds":int(os.environ["TS_T"])}))')
  fi
  api PUT "/v1/projects/$(urlenc "$id")/answer-link-ttl" "$data" >/dev/null
  if [ -n "$clear" ]; then
    echo "cleared the answer-link lifetime for $id (falls back to 7 days)"
  else
    echo "set the answer-link lifetime for $id to ${secs}s"
  fi
}

# takomo project rm ID [--force] — cascade-delete a project and ALL of its tickets,
# comments, deps, and events. Refused (409) if any ticket has an active claim
# unless --force is given. Tokens scoped to the project are left as-is; they
# simply stop resolving once it is gone (revoke them with `takomo token revoke`).
cmd_project_rm() {
  local id="" force=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      -*) die "project rm: unknown flag $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "project rm: unexpected argument '$1'"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "project rm: ID is required"

  # Confirm the project exists (the list is authoritative; metrics omits empty
  # projects). Die early with a clear message if it is unknown to this token.
  api GET /v1/projects >/dev/null
  python3 - "$REQ_OUT" "$id" <<'PY'
import json, sys
rows = json.load(open(sys.argv[1]))
pid = sys.argv[2]
if not any(p.get("id") == pid for p in rows):
    sys.stderr.write(f"project rm: no project '{pid}' visible to this token\n")
    sys.exit(2)
PY

  # Pre-delete summary of what will cascade (metrics has per-project counts;
  # a project with no tickets simply won't appear there — treat as empty).
  api GET /v1/metrics >/dev/null
  python3 - "$REQ_OUT" "$id" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
pid = sys.argv[2]
p = (d.get("projects") or {}).get(pid) or {}
print(f"deleting project '{pid}': {p.get('total',0)} ticket(s), {p.get('open_claims',0)} open claim(s)")
bs = p.get("by_state") or {}
if bs:
    print("  by state: " + ", ".join(f"{k}={v}" for k, v in sorted(bs.items())))
print("  cascade removes every ticket, comment, dependency, and event under it.")
PY

  local path; path="/v1/projects/$(urlenc "$id")"
  [ -n "$force" ] && path="$path?force=true"
  api DELETE "$path" >/dev/null
  echo "deleted project $id"
}

