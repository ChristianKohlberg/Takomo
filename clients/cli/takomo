cmd_ask() {
  local id=${1:-}; [ -n "$id" ] || die "ask: usage: takomo ask ID --title T [--kind confirm|choose|clarify|approve] [--advisory] [--body B] [--option O]... [--option-desc D]... [--expertise TAG]... [--urgency U] [--multi] [--rec-multi OPT]... [--recommend R] [--rec-note WHY] [--confidence 1-4] [--summary S] [--expires-in SECS] [--on-timeout recommended|escalate|cancel]"; shift
  local kind="confirm" title="" body="" urgency="" recommend="" expires="" ontimeout="" mode="" recnote="" summary="" confidence="" multi="" assignee=""
  local -a options=() expertise=() optdescs=() recmulti=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind)       kind=$2; shift 2 ;;
      --advisory)   mode="advisory"; shift ;;
      --title)      title=$2; shift 2 ;;
      --body)       body=$2; shift 2 ;;
      --option)     options+=("$2"); shift 2 ;;
      --option-desc) optdescs+=("$2"); shift 2 ;;
      --multi)      multi=1; shift ;;
      --rec-multi)  recmulti+=("$2"); shift 2 ;;
      --expertise)  expertise+=("$2"); shift 2 ;;
      --assignee)   assignee=$2; shift 2 ;;
      --urgency)    urgency=$2; shift 2 ;;
      --recommend)  recommend=$2; shift 2 ;;
      --rec-note)   recnote=$2; shift 2 ;;
      --confidence) confidence=$2; shift 2 ;;
      --summary)    summary=$2; shift 2 ;;
      --expires-in) expires=$2; shift 2 ;;
      --on-timeout) ontimeout=$2; shift 2 ;;
      *) die "ask: unknown flag $1" ;;
    esac
  done
  [ -n "$title" ] || die "ask: --title is required"
  local fence; fence=$(fence_load "$id")
  local data; data=$(TS_ID="$id" TS_KIND="$kind" TS_TITLE="$title" TS_BODY="$body" \
    TS_URG="$urgency" TS_REC="$recommend" TS_EXP="$expires" TS_OT="$ontimeout" TS_FENCE="$fence" TS_MODE="$mode" \
    TS_ASSIGNEE="$assignee" \
    TS_RECNOTE="$recnote" TS_SUMMARY="$summary" TS_CONF="$confidence" TS_MULTI="$multi" \
    TS_OPTS="$(printf '%s\n' "${options[@]:-}")" TS_EXPERT="$(printf '%s\n' "${expertise[@]:-}")" \
    TS_OPTDESCS="$(printf '%s\n' "${optdescs[@]:-}")" TS_RECMULTI="$(printf '%s\n' "${recmulti[@]:-}")" \
    python3 <<'PY'
import json, os
d = {"ticket": os.environ["TS_ID"], "kind": os.environ["TS_KIND"], "title": os.environ["TS_TITLE"]}
if os.environ.get("TS_MODE"): d["mode"] = os.environ["TS_MODE"]
if os.environ.get("TS_MULTI"): d["multi"] = True
recmulti = [l for l in os.environ.get("TS_RECMULTI","").splitlines() if l]
if recmulti: d["recommended_multi"] = recmulti
if os.environ.get("TS_BODY"): d["body"] = os.environ["TS_BODY"]
if os.environ.get("TS_URG"): d["urgency"] = os.environ["TS_URG"]
if os.environ.get("TS_REC"): d["recommended"] = os.environ["TS_REC"]
if os.environ.get("TS_RECNOTE"): d["recommended_note"] = os.environ["TS_RECNOTE"]
if os.environ.get("TS_SUMMARY"): d["summary"] = os.environ["TS_SUMMARY"]
if os.environ.get("TS_CONF"): d["confidence"] = int(os.environ["TS_CONF"])
if os.environ.get("TS_EXP"): d["expires_in_seconds"] = int(os.environ["TS_EXP"])
if os.environ.get("TS_OT"): d["on_timeout"] = os.environ["TS_OT"]
if os.environ.get("TS_FENCE"): d["fence"] = int(os.environ["TS_FENCE"])
opts = [l for l in os.environ.get("TS_OPTS","").splitlines() if l]
descs = [l for l in os.environ.get("TS_OPTDESCS","").splitlines() if l]
if opts:
    # pair options with descriptions when provided 1:1, else send plain strings
    if descs and len(descs) == len(opts):
        d["options"] = [{"value": o, "desc": dd} for o, dd in zip(opts, descs)]
    else:
        d["options"] = opts
