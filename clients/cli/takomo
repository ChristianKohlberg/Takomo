r = d.get("resume", {})
qid, tid, state = q.get("id","?"), t.get("id","?"), t.get("state","?")
# Never report a resume that did not happen. A blocking answer can land with the
# ticket left parked, and it is then out of the ready queue until someone moves
# it — printing the blocked state as if it were the resume target is how that
# went unnoticed.
