cmd_watch() {
  local project="" since=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project=$2; shift 2 ;;
      --since)   since=$2; shift 2 ;;
      -*) die "watch: unknown flag $1" ;;
      *) die "watch: unexpected argument '$1'" ;;
    esac
  done
  [ -z "$project" ] && project=${TAKOMO_PROJECT:-}
  local pq=""
  [ -n "$project" ] && pq="&project=$(urlenc "$project")"

  local cursor
  if [ -n "$since" ]; then
    cursor=$since
  else
    # Fast-forward to the current tail so we print only new events.
    cursor=0
    while :; do
      api GET "/v1/events?since=$cursor&wait=0&limit=1000$pq" >/dev/null
      local nc; nc=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d.get("cursor",0))' "$REQ_OUT")
      local cnt; cnt=$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1])).get("events",[])))' "$REQ_OUT")
      cursor=$nc
      [ "$cnt" -gt 0 ] || break
    done
  fi
  echo "watching events from cursor $cursor${project:+ (project $project)} — Ctrl-C to stop" >&2

  while :; do
    api GET "/v1/events?since=$cursor&wait=25&limit=500$pq" >/dev/null
    cursor=$(python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
for e in d.get("events", []):
    payload = e.get("payload") or {}
    bits = []
    for k in ("to", "from", "changed", "fence", "reason", "title"):
        if k in payload and payload[k] not in (None, "", []):
            bits.append(f"{k}={payload[k]}")
    extra = ("  " + " ".join(bits)) if bits else ""
    tk = e.get("ticket") or "-"
    print(f"[{e.get('at','')}] #{e.get('seq')}  {e.get('kind',''):<14} {tk:<14} @{e.get('actor','')}{extra}",
          file=sys.stderr)
print(d.get("cursor", 0))
PY
)
  done
}

# --- import ------------------------------------------------------------------
# Look up a new (takomo) id for an origin id in the id-map file.
import_map_get() { awk -F'\t' -v k="$1" '$1==k{print $2; exit}' "$2"; }

# Drive a freshly created ticket ($1) to its target state via a precomputed
# move list ($2, JSON array of {to, claim}). Best-effort: echoes "ok" or
# "fail:<why>". Claims when an edge requires it, echoes the saved fence, and
# releases any lease left held on a non-terminal target.
import_reach_state() {
  local nid=$1 moves=$2
  local n; n=$(TS_M="$moves" python3 -c 'import json,os; print(len(json.loads(os.environ["TS_M"])))')
  local holding="" i=0
  while [ "$i" -lt "$n" ]; do
    local to claim
    to=$(TS_M="$moves" TS_I="$i" python3 -c 'import json,os; print(json.loads(os.environ["TS_M"])[int(os.environ["TS_I"])]["to"])')
    claim=$(TS_M="$moves" TS_I="$i" python3 -c 'import json,os; print("1" if json.loads(os.environ["TS_M"])[int(os.environ["TS_I"])]["claim"] else "0")')
    if [ "$claim" = "1" ] && [ -z "$holding" ]; then
      local code; code=$(api_try POST "/v1/tickets/$(urlenc "$nid")/claim" '{}')
      [ "$code" = "200" ] || { echo "fail:claim($code)"; return 0; }
      holding=$(save_fence_from_response "$nid")
    fi
    local fence data code
    fence=$(fence_load "$nid")
    data=$(TS_TO="$to" TS_F="$fence" python3 -c 'import json,os; d={"to":os.environ["TS_TO"]};
f=os.environ.get("TS_F","");
d["fence"]=int(f) if f else None;
print(json.dumps({k:v for k,v in d.items() if v is not None}))')
    code=$(api_try POST "/v1/tickets/$(urlenc "$nid")/transition" "$data")
    [ "$code" = "200" ] || { echo "fail:->$to($code)"; return 0; }
    local hasclaim; hasclaim=$(python3 -c 'import json,sys; print(1 if json.load(open(sys.argv[1])).get("claim") else 0)' "$REQ_OUT")
    if [ "$hasclaim" = "0" ]; then fence_clear "$nid"; holding=""; fi
    i=$((i + 1))
  done
  if [ -n "$holding" ] && [ -n "$(fence_load "$nid")" ]; then
    local fence; fence=$(fence_load "$nid")
    api_try POST "/v1/tickets/$(urlenc "$nid")/release" \
      "$(TS_F="$fence" python3 -c 'import json,os; print(json.dumps({"fence":int(os.environ["TS_F"]),"reason":"import: state applied"}))')" >/dev/null
    fence_clear "$nid"
  fi
  echo "ok"
}

cmd_import() {
  local source="" path="" project=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)    source=$2; shift 2 ;;
      --project) project=$2; shift 2 ;;
      -*) die "import: unknown flag $1" ;;
      *) path=$1; shift ;;
    esac
  done
  [ -n "$source" ] || die "import: --from takomo|beads|beans is required"
  [ -n "$path" ]   || die "import: PATH (a file, or a directory for beans) is required"
  case "$source" in
    takomo|beads|beans) ;;
    *) die "import: --from must be one of: takomo, beads, beans" ;;
  esac
  [ -e "$path" ] || die "import: no such file or directory: $path"
  project=$(resolve_project "$project")

  # The target workflow (state map + reach planning) and this token's scopes
  # (so planning prefers moves we can actually make) drive the mapping.
  api GET "/v1/projects/$(urlenc "$project")/workflow" >/dev/null
  local wf_file; wf_file=$(mktemp); cp "$REQ_OUT" "$wf_file"
  api GET /v1/whoami >/dev/null
  local myscopes; myscopes=$(python3 -c 'import json,sys; print(",".join(json.load(open(sys.argv[1])).get("scopes",[])))' "$REQ_OUT")

  # Normalize the source + plan each item (create body, relations, state moves).
  local planner; planner=$(import_planner_path)
  local planned; planned=$(mktemp)
  if ! TS_SOURCE="$source" TS_PATH="$path" TS_PROJECT="$project" TS_WF="$wf_file" TS_SCOPES="$myscopes" \
       python3 "$planner" > "$planned"; then
    rm -f "$wf_file" "$planned" "$planner"
    die "import: could not parse/plan the source data (a beans import needs PyYAML: pip install pyyaml)"
  fi
  local total; total=$(grep -c . "$planned" || true)
  [ "${total:-0}" -gt 0 ] || { echo "import: nothing to import (0 items parsed)"; rm -f "$wf_file" "$planned"; return; }
  echo "Importing ${total} item(s) from $source into project '$project'..."

  # Pass A — create (idempotent on origin id: safe to re-run).
  local map fresh; map=$(mktemp); fresh=$(mktemp)
  local created=0 skipped=0 failed=0
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    local origin body idem code
    origin=$(TS_I="$item" python3 -c 'import json,os; print(json.loads(os.environ["TS_I"])["origin_id"])')
    body=$(TS_I="$item" python3 -c 'import json,os; print(json.dumps(json.loads(os.environ["TS_I"])["create_body"]))')
    idem=$(printf '%s' "$origin" | cut -c1-128)
    code=$(api_try POST /v1/tickets "$body" "Idempotency-Key: $idem")
    case "$code" in
      201) created=$((created + 1)) ;;
      200) skipped=$((skipped + 1)) ;;
      *) failed=$((failed + 1)); echo "  ! create failed for origin '$origin' (HTTP $code)" >&2; print_api_error "$code"; continue ;;
    esac
    local nid; nid=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$REQ_OUT")
    printf '%s\t%s\n' "$origin" "$nid" >> "$map"
    [ "$code" = "201" ] && printf '%s\n' "$origin" >> "$fresh"
  done < "$planned"

  # Pass B/C/D — relations, comments, state moves for FRESHLY created tickets
  # only (replays are already wired; re-driving them would double comments).
  local rel=0 parents=0 coms=0 states_ok=0 states_skipped=0
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    local origin; origin=$(TS_I="$item" python3 -c 'import json,os; print(json.loads(os.environ["TS_I"])["origin_id"])')
    grep -qxF "$origin" "$fresh" || continue
    local nid; nid=$(import_map_get "$origin" "$map"); [ -n "$nid" ] || continue

    # parent (map origin -> new id).
    local porigin; porigin=$(TS_I="$item" python3 -c 'import json,os; p=json.loads(os.environ["TS_I"]).get("parent"); print(p or "")')
    if [ -n "$porigin" ]; then
      local pnew; pnew=$(import_map_get "$porigin" "$map")
      if [ -n "$pnew" ]; then
        [ "$(api_try PATCH "/v1/tickets/$(urlenc "$nid")" "$(TS_P="$pnew" python3 -c 'import json,os; print(json.dumps({"parent":os.environ["TS_P"]}))')")" = "200" ] && parents=$((parents + 1))
      fi
    fi
    # blocked_by edges.
    local bbs; bbs=$(TS_I="$item" python3 -c 'import json,os; print("\n".join(json.loads(os.environ["TS_I"]).get("blocked_by") or []))')
    local bb
    while IFS= read -r bb; do
      [ -n "$bb" ] || continue
      local bnew; bnew=$(import_map_get "$bb" "$map"); [ -n "$bnew" ] || continue
      if [ "$(api_try POST "/v1/tickets/$(urlenc "$nid")/deps" "$(TS_B="$bnew" python3 -c 'import json,os; print(json.dumps({"blocked_by":os.environ["TS_B"]}))')")" = "201" ]; then
        rel=$((rel + 1))
      fi
    done <<< "$bbs"
    # comments (fresh only, since comments have no idempotency).
    local ncom; ncom=$(TS_I="$item" python3 -c 'import json,os; print(len(json.loads(os.environ["TS_I"]).get("comments") or []))')
    local ci=0
    while [ "$ci" -lt "$ncom" ]; do
      local ctext; ctext=$(TS_I="$item" TS_C="$ci" python3 -c 'import json,os; print(json.loads(os.environ["TS_I"])["comments"][int(os.environ["TS_C"])].get("body",""))')
      if [ -n "$ctext" ]; then
        api_try POST "/v1/tickets/$(urlenc "$nid")/comments" "$(TS_T="$ctext" python3 -c 'import json,os; print(json.dumps({"body":os.environ["TS_T"]}))')" >/dev/null && coms=$((coms + 1))
      fi
      ci=$((ci + 1))
    done
    # state moves.
    local moves; moves=$(TS_I="$item" python3 -c 'import json,os; m=json.loads(os.environ["TS_I"]).get("moves"); print(json.dumps(m) if m else "")')
    if [ -n "$moves" ] && [ "$moves" != "[]" ] && [ "$moves" != "null" ]; then
      local r; r=$(import_reach_state "$nid" "$moves")
      if [ "$r" = "ok" ]; then states_ok=$((states_ok + 1)); else states_skipped=$((states_skipped + 1)); fi
    fi
  done < "$planned"

  rm -f "$wf_file" "$planned" "$map" "$fresh" "$planner"
  echo "Done: $created created, $skipped already-present (replayed), $failed failed."
  echo "  relations: $parents parent link(s), $rel dep edge(s) wired; comments: $coms added."
  echo "  state applied to $states_ok ticket(s); $states_skipped left in the initial state (gated/blocked — origin status preserved in metadata.import.origin_status)."
}

# Write the import planner python to a temp file and echo its path. Kept as a
# heredoc (not inline) because it is large; the caller removes the file.
import_planner_path() {
  local f; f=$(mktemp)
  cat > "$f" <<'PY'
import collections, glob, heapq, json, os, sys

source = os.environ["TS_SOURCE"]
path = os.environ["TS_PATH"]
project = os.environ["TS_PROJECT"]
wf = json.load(open(os.environ["TS_WF"]))
my_scopes = set(s for s in os.environ.get("TS_SCOPES", "").split(",") if s)

states = {s["id"]: s for s in wf.get("states", [])}
initial = wf.get("initial")
transitions = wf.get("transitions", [])
by_cat = {}
for sid, s in states.items():
    by_cat.setdefault(s.get("category"), []).append(sid)

VALID_TYPES = {"epic", "task", "bug", "spike"}
VALID_PRI = {"critical", "high", "normal", "low"}
TYPE_MAP = {"epic": "epic", "milestone": "epic", "task": "task", "feature": "task",
            "story": "task", "chore": "task", "bug": "bug", "defect": "bug",
            "spike": "spike", "research": "spike"}
PRI_MAP = {"critical": "critical", "urgent": "critical", "high": "high", "p1": "high",
           "normal": "normal", "medium": "normal", "p2": "normal", "low": "low",
           "p3": "low", "deferred": "low"}


def map_type(t):
    t = (t or "").strip().lower()
    return TYPE_MAP.get(t, t if t in VALID_TYPES else "task")


def map_priority(p):
    p = ("" if p is None else str(p)).strip().lower()
    return PRI_MAP.get(p, p if p in VALID_PRI else "normal")


def desired_category(status):
    s = (status or "").strip().lower().replace("_", "-")
    beads = {"open": "todo", "in-progress": "in_progress", "closed": "done",
             "done": "done", "deferred": "blocked", "blocked": "blocked",
             "cancelled": "cancelled", "canceled": "cancelled"}
    beans = {"todo": "todo", "draft": "todo", "in-progress": "in_progress",
             "completed": "done", "done": "done", "scrapped": "cancelled",
             "blocked": "blocked"}
    if source == "beads":
        return beads.get(s, "todo")
    if source == "beans":
        return beans.get(s, "todo")
    return None


def pick_target_state(status, category_hint):
    # takomo round-trip: an exact state id wins.
    if source == "takomo" and status in states:
        return status
    cat = category_hint if source == "takomo" else desired_category(status)
    if not cat:
        cat = category_hint or states.get(initial, {}).get("category")
    cands = by_cat.get(cat, [])
    if not cands:
        return initial
    if initial in cands:
        return initial
    if cat in ("done", "cancelled"):
        term = [c for c in cands if states[c].get("terminal")]
        if term:
            return term[0]
    claimable = [c for c in cands if states[c].get("claimable")]
    return (claimable or cands)[0]


def edge_reqs(tr):
    reqs = tr.get("requires", []) or []
    claim = "claim" in reqs
    scopes = [r.split("scope:", 1)[1] for r in reqs if r.startswith("scope:")]
    return claim, scopes


def plan_moves(target):
    if target == initial or not target:
        return []
    adj = collections.defaultdict(list)
    for tr in transitions:
        adj[tr["from"]].append(tr)
    best = {initial: (0, 0)}
    prev = {}
    pq = [(0, 0, initial)]
    while pq:
        unmet, length, node = heapq.heappop(pq)
        if (unmet, length) > best.get(node, (1e9, 1e9)):
            continue
        for tr in adj.get(node, []):
            _, scopes = edge_reqs(tr)
            u = unmet + sum(1 for sc in scopes if sc not in my_scopes)
            l = length + 1
            nb = tr["to"]
            if (u, l) < best.get(nb, (1e9, 1e9)):
                best[nb] = (u, l)
                prev[nb] = (node, tr)
                heapq.heappush(pq, (u, l, nb))
    if target not in prev:
        return None
    out = []
    cur = target
    while cur != initial:
        node, tr = prev[cur]
        claim, _ = edge_reqs(tr)
        out.append({"to": tr["to"], "claim": claim})
        cur = node
    out.reverse()
    return out


def clean_labels(raw):
    out = []
    for l in raw or []:
        l = str(l).strip()
        if l and len(l) <= 100 and l not in out:
            out.append(l)
    return out


def parse_frontmatter(text):
    # returns (dict, body). Requires a leading '---' YAML block.
    import yaml
    if not text.startswith("---"):
        return {}, text
    parts = text.split("\n---", 1)
    # handle both '---\n...\n---\n' forms
    lines = text.splitlines()
    if lines and lines[0].strip() == "---":
        end = None
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                end = i
                break
        if end is not None:
            fm = yaml.safe_load("\n".join(lines[1:end])) or {}
            body = "\n".join(lines[end + 1:]).lstrip("\n")
            return (fm if isinstance(fm, dict) else {}), body
    return {}, text


items = []
if source == "takomo":
    for line in open(path):
        line = line.strip()
        if not line:
            continue
        d = json.loads(line)
        items.append({
            "origin_id": d.get("id"),
            "title": d.get("title", ""),
            "body": d.get("body", ""),
            "type": d.get("type", "task"),
            "status": d.get("state", ""),
            "state_category": d.get("state_category"),
            "priority": d.get("priority", "normal"),
            "labels": d.get("labels", []) or [],
            "parent": d.get("parent"),
            "blocked_by": d.get("blocked_by", []) or [],
            "created_at": d.get("created_at"),
            "updated_at": d.get("updated_at"),
            "extra_metadata": d.get("metadata", {}) or {},
            "comments": [{"body": c.get("body", "")} for c in (d.get("comments") or [])],
        })
elif source == "beads":
    for line in open(path):
        line = line.strip()
        if not line:
            continue
        d = json.loads(line)
        bb = d.get("blocked_by")
        if bb is None:
            bb = []
            for dep in (d.get("dependencies") or []):
                if isinstance(dep, dict):
                    if dep.get("type") in (None, "blocks", "blocked-by", "blocked_by"):
                        bb.append(dep.get("id") or dep.get("target") or dep.get("to"))
                else:
                    bb.append(dep)
        items.append({
            "origin_id": d.get("id") or d.get("issue_id"),
            "title": d.get("title") or d.get("summary") or "",
            "body": d.get("description") or d.get("body") or "",
            "type": d.get("type") or d.get("issue_type") or "task",
            "status": d.get("status", ""),
            "priority": d.get("priority", "normal"),
            "labels": d.get("labels") or d.get("tags") or [],
            "parent": d.get("parent") or d.get("parent_id") or d.get("epic"),
            "blocked_by": [x for x in bb if x],
            "created_at": d.get("created_at") or d.get("created"),
            "updated_at": d.get("updated_at") or d.get("updated"),
            "extra_metadata": {},
            "comments": [{"body": c.get("body") or c.get("text", "")} for c in (d.get("comments") or []) if isinstance(c, dict)],
        })
elif source == "beans":
    root = path
    if os.path.isdir(os.path.join(path, ".beans")):
        root = os.path.join(path, ".beans")
    files = sorted(glob.glob(os.path.join(root, "*.md")) + glob.glob(os.path.join(root, "archive", "*.md")))
    for fp in files:
        text = open(fp).read()
        fm, body = parse_frontmatter(text)
        base = os.path.basename(fp)
        oid = fm.get("id") or base.split("--", 1)[0].rsplit(".md", 1)[0]
        items.append({
            "origin_id": oid,
            "title": fm.get("title", "") or "",
            "body": body or "",
            "type": fm.get("type", "task"),
            "status": fm.get("status", ""),
            "priority": fm.get("priority", "normal"),
            "labels": fm.get("tags") or [],
            "parent": fm.get("parent"),
            "blocked_by": fm.get("blocked_by") or [],
            "created_at": fm.get("created_at"),
            "updated_at": fm.get("updated_at"),
            "extra_metadata": {},
            "comments": [],
        })

for it in items:
    tgt = pick_target_state(it.get("status"), it.get("state_category"))
    moves = plan_moves(tgt)
    md = {
        "import.source": source,
        "import.origin_id": it.get("origin_id"),
        "import.origin_status": it.get("status") or "",
    }
    for k in ("created_at", "updated_at"):
        if it.get(k):
            md[f"import.{k}"] = it[k]
    if it.get("parent"):
        md["import.origin_parent"] = it["parent"]
    if it.get("blocked_by"):
        md["import.origin_blocked_by"] = it["blocked_by"]
    for k, v in (it.get("extra_metadata") or {}).items():
        md.setdefault(k, v)
    title = (it.get("title") or "").strip() or "(untitled import)"
    create_body = {
        "project": project,
        "title": title[:300],
        "type": map_type(it.get("type")),
        "priority": map_priority(it.get("priority")),
        "metadata": md,
    }
    if it.get("body"):
        create_body["body"] = it["body"]
    labels = clean_labels(it.get("labels"))
    if labels:
        create_body["labels"] = labels
    print(json.dumps({
        "origin_id": it.get("origin_id"),
        "create_body": create_body,
        "parent": it.get("parent"),
        "blocked_by": [b for b in (it.get("blocked_by") or []) if b],
        "target_state": tgt,
        "moves": moves,
        "comments": it.get("comments") or [],
    }))
PY
  echo "$f"
}

cmd_help() {
  cat <<'EOF'
takomo — command-line client for the takomo

Environment (or run `takomo init` to write repo-local .takomo/ config):
  TAKOMO_URL      /v1 base, e.g. https://host/v1        (required)
  TAKOMO_TOKEN    bearer token                          (required)
  TAKOMO_PROJECT  default project when --project omitted (optional)
  TAKOMO_ACTOR    your actor name, for `ls --mine`       (optional)
  TAKOMO_RETRIES  retries on a 502/503/504 or an unreachable host (default 3)
  TAKOMO_RETRY_MAX_SECONDS
                  total budget for the backoff waits     (default 20)

A gateway blip in front of the store is retried with exponential backoff, but
only for requests that are safe to send twice. A write that would double if it
were replayed — a comment, a token or share mint, `next`, `promote` — is never
retried automatically: it fails with a loud "THE WRITE WAS NOT CONFIRMED", and
you should check with `takomo show ID` before re-running it.

Onboarding & identity:
  takomo init [PROJECT] [--workflow simple|FILE] [--url URL] [--actor NAME]
         create/prepare a project for THIS git repo and write .takomo/ config
  takomo whoami              show this token's actor, scopes, projects, and person

Token administration (admin scope):
  takomo token create --actor NAME [--scopes read,write] [--projects P] [--expires 90d]
                      [--user HANDLE]   bind this credential to a person, so work
                                        addressed to them can be answered from it
  takomo token ls
  takomo token revoke ID

People — who work can be addressed to (writes need admin scope):
  takomo user ls [--project P] [-q TEXT] [--all]
  takomo user show HANDLE
  takomo user new HANDLE [--name "Full Name"] [--email a@b.c] [--project P]...
  takomo user set HANDLE [--name ...] [--email ...|--no-email]
  takomo user disable HANDLE | enable HANDLE
  takomo user member HANDLE PROJECT | unmember HANDLE PROJECT
         A user is not a login and grants no access — scopes are still what a
         credential may do. It is how a question stops being routed to "whoever
         holds expert:domain:billing" and starts waiting on Ada. Membership says
         who may be handed work in a project. Nobody is ever deleted; disable
         them, and every past decision still reads back with their name on it.

Project administration (admin scope):
  takomo project rm ID [--force]
         cascade-delete a project and ALL its tickets, comments, deps, and
         events. Refused if a ticket has an active claim unless --force is given.
         Tokens scoped to the project are left as-is (revoke with `takomo token revoke`).
  takomo project style ID ["TEXT" | --file PATH | --clear]
         the project's house style for the text agents write — ticket titles and
         bodies, comments, and ask-a-human questions. Agents get it back as a
         `style_hint` on the work loop. With no value, prints the current guide.
  takomo project language ID [LANG | --clear]
         the human-facing language ask-a-human questions belong in (e.g. German).
         With no value, prints the current setting. Both of the above are advisory.
  takomo project answer-ttl ID [7d | --clear]
         how long an answer link minted for one of this project's questions stays
         valid (24h, 7d, 90m, 3600s, or plain seconds; max 30d). ENFORCED, not
         advisory — it is the lifetime of a credential handed outside the org.
         With no value, prints the current setting; --clear falls back to 7 days.

Finding & creating work:
  takomo new [--project P] [--type task|bug|epic|spike] [--priority critical|high|normal|low]
         [--parent ID] [--label L]... [--body TEXT] TITLE
  takomo ls  [--project P] [--state S] [--epic ID] [--label L]... [--mine] [--archived] [-q TEXT]
             [--limit N] [--cursor C]   page size (default 100) and the next page
  takomo ready [--project P] [--limit N]
  takomo impact  [--project P] [--epic ID] [--limit N]
         open blockers ranked by how much closing ONE of them would release:
         `unblocks` counts the tickets that would leave the blocked set, split
         into direct (they hold the edge) and downstream (inherited from an
         ancestor). A ticket held by two blockers counts towards neither alone.
  takomo roadmap [--project P] [--epic ID]
         progress rollup, twice over: a bar + child counts per EPIC (one
                                 version) and per INITIATIVE (the lane it ships
                                 in, which never closes), contradiction flags,
                                 and "(no epic)" / "(no initiative)" buckets.
                                 --epic reports one epic, without either bucket
  takomo show ID

Claiming & progressing (the fence is remembered locally after a claim):
  takomo claim ID            claim a specific ready ticket
  takomo next [--project P] [--wait SECS]   atomically claim the next ready ticket
  takomo start ID            claim if needed, then move to the workflow's in-progress state
  takomo done ID             move to the workflow's done state
  takomo block ID            move to the workflow's blocked state
  takomo cancel ID           move to the workflow's cancelled state
  takomo move ID STATE       move to an arbitrary workflow state
  takomo release ID [REASON] return the ticket to the queue

Mindmaps (brainstorming, before any of it is an idea):
  takomo mindmap new TITLE [--project P]   the title is the root
  takomo mindmap ls [--project P] [--status open|parked|distilled]
  takomo mindmap show ID [--node NODE]     the tree, with node ids beside it
  takomo mindmap add ID "a thought" [--parent NODE]
  takomo mindmap promote ID NODE --to epic|initiative
  takomo mindmap rm ID
         A tree you grow at conversation speed. A node is a sentence or two —
         that brevity is the method. When a branch turns out to matter, promote
         it: `epic` makes an epic with its children as tickets, `initiative`
         makes one seeded with the subtree. The node stays either way, carrying
         what it became, so the map keeps working as navigation afterwards.
         A mindmap is scratch by design: `rm` is ordinary, and what its branches
         became is untouched.

Ask a human (block on a human decision, then resume):
  takomo ask ID --title T [--kind confirm|choose|clarify|approve] [--advisory]
         [--body B] [--option O]... [--option-desc D]... [--multi] [--rec-multi O]...
         [--expertise TAG]... [--assignee HANDLE] [--urgency U] [--recommend R]
         [--rec-note R] [--confidence 1..4] [--summary S]
         [--expires-in SECS] [--on-timeout recommended|escalate|cancel]
         park the ticket in a blocked state, release your lease, and post a
         question for a human; resume after every open question is answered.
         --advisory records a routed decision WITHOUT parking (e.g. an epic
         or strategic question). Write decision-ready questions: --option-desc
         explains each choice, --rec-note the rationale, --confidence (1-4) the
         strength, --summary a one-line preview; --multi lets the human pick
         several options (--rec-multi pre-selects). The response returns `hints`
         naming any field that would sharpen the inbox card (never fails).
         --assignee addresses it to one person (takomo user ls) instead of, or
         as well as, a domain — the difference between "someone who knows
         billing" and "Ada". They must be a member of the ticket's project.
  takomo questions [--project P] [--ticket T] [--status S] [--mine]
         [--assignee HANDLE] [--unassigned]
         the inbox: open questions. --mine is everything waiting on you, in both
         senses — addressed to you by name, or covered by your expert:<tag>
         scopes. --unassigned is the triage read: what nobody has been asked yet.
  takomo assign QID HANDLE | QID --none   (human scope)
         address an open question to a person, or hand it back to the queue. The
         usual case, since the agent that asked rarely knows who owns the
         decision. Routing only: anyone with the authority can still answer, so
         nothing waits on somebody who is away.
  takomo answer QID ANSWER [--note N] [--resume-to STATE]   (needs human scope)
  takomo reply QID MESSAGE   (write scope) answer a human's follow-up request
         with the research they asked for; the question stays parked, awaiting
         flips back to the human
  takomo options QID --option O --option O [--option-desc D]... [--recommend R]
         [--clear-recommend] [--rec-multi O]... [--rec-note WHY] [--reason WHY]
         (write scope) revise a still-open choose question's options when your
         research shows the choices were wrong — better than withdrawing and
         losing the thread. REPLACES the set (give all of them, min 2). The
         recommendation must be one of the new options: pass --recommend, or
         --clear-recommend if none applies. --reason is recorded on the ticket
         for a human who already read the old set.
  takomo reopen QID          (human scope) take back an answered question while
         its answer isn't yet in use (re-parks the ticket)
  takomo withdraw QID [REASON]
  takomo answer-link QID [--ttl 7d] [--actor NAME]
         mint a scoped, expiring, single-use link so an OUTSIDE expert can
         answer just this one question without holding a token.
         --ttl accepts 24h, 7d, 90m, 3600s or plain seconds (max 30d) and wins
         over the project default; omit it to use `project answer-ttl`, which
         itself falls back to 7 days.
  takomo answer-link revoke GRANT-ID

Annotating:
  takomo comment ID TEXT
  takomo link ID [--pr URL] [--branch B] [--env URL] [--run URL] [--commit SHA]
         --commit is the proof a ticket is really done: the FULL sha (or commit
         URL) of the work that closes it. Checkable long after the fact, and
         what `git tag --contains` / `git merge-base --is-ancestor` answer
         release and deploy questions from. Projects can require it via
         `guard:has_link:commit` on the done transition.
  takomo dep ID --blocked-by OTHER
  takomo deps ID [--blocks] [--tree]   show what blocks ID (or, with --blocks, what
                                   ID blocks); --tree walks the chain transitively

Tagging (name entities per project, then tag tickets — reference metadata only):
  takomo tag add ID REF...             tag a ticket, each REF a kind:handle
                                   (e.g. person:ada component:billing); unknown
                                   handles are registered on the fly
  takomo tag rm ID REF...              remove tag references from a ticket
  takomo tag ls [--kind K] [-q TEXT]   list the project's tag registry
  takomo tag new --kind K --handle H [--label L] [--meta k=v ...]   register/enrich
  takomo tag show REF                  show one entity (REF = kind:handle)
  takomo tag delete REF                remove a registry entry (ticket refs kept)
         Filter tickets by tag:  takomo ls --tag person:ada  |  --tag-kind person
         Attach at creation:     takomo new "…" --tag person:ada
         A tag REFERENCES a person; `takomo user` is the directory that says who
         they are and lets a decision be addressed to them. Same handle, one
         person: `tag ls --kind person` shows which handles are in the directory.

Shareable read-only web views (write scope):
  takomo share --project P [--ttl 24h]   mint a read-only, expiring link to a whole
                                     project's board; prints the full URL
  takomo share --epic ID [--ttl 24h]     mint a link to a ticket + its full subtree
  takomo share ls                        list shares (id, kind, ref, expiry)
  takomo share revoke ID                 revoke a share immediately
         --ttl accepts 24h, 7d, 90m, 3600s (default 24h, max 30d). The token
         rides in the URL fragment (#s=...); anyone with the link can view until
         it expires.

Archiving (hides tickets from default list/ready/board/metrics views):
  takomo archive ID                    archive one ticket
  takomo archive --state done|cancelled [--project P]   bulk-archive terminal tickets
  takomo unarchive ID                  return a ticket to the default views
  takomo ls --archived                 list archived tickets
  takomo promote ID TARGET [--url U] [--ref R] [--note N]
         record that the work reached a stage (e.g. staging, production,
         published) — free-form target; history kept, latest shown on the board

Initiatives (an idea being nurtured — not work: no claim, no lease, no queue):
  takomo initiative new TITLE [--project P] [--summary S] [--status open|parked|distilled]
         [--label L]... [--tag T]...
  takomo initiative append ID --kind K --source S [--text T | --text-file FILE|-]
         [--title T] [--source-uri U] [--origin-at RFC3339] [--origin]
         [--attach FILE] [--mime M] [--filename N]
         one contribution: a note, a research finding, a colleague's feedback, a
         transcript, a document. --source is required — an entry whose origin
         nobody recorded is text nobody can weigh later. --text-file (or `-` for
         stdin) is how prose gets in without fighting shell quoting; --origin
         marks the words the idea ARRIVED in, quoted above every pane on the page.
  takomo initiative ls [--project P] [--status S] [--label L] [--tag T] [-q TEXT]
         [--limit N] [--cursor C]
         each row says what has accumulated, and — when there is any — what is
         WAITING on a person: suggested changes nobody has decided, open notes
         nobody has answered. That line is the one that says which to open next.
  takomo initiative show ID [--limit N] [--cursor C]   description, then entries
  takomo initiative set ID [--title T] [--summary S] [--status S] [--label L]... [--tag T]...
         edit how it is DESCRIBED; entries are append-only on every surface.
         Repeating --label/--tag replaces the whole list.
         `parked` is set aside; `distilled` means its substance became tickets.

  Writing the three-pane document — the panes, their citations, and the threads
  anchored in them — stays in /initiatives, where the editor knows about citation
  marks. `takomo roadmap` shows initiatives as the lanes their epics ship in.

Verification (checks — how a "done" claim becomes a verified one):
  takomo verify [--project P]          what needs re-verifying, split by who can
         clear it: an agent list and a human list. Human time is the scarce
         resource, so the split IS the answer.
  takomo verdict CASE --pass|--fail|--blocked|--unreachable [--note N] [--human]
         [--environment SLUG]
         report what you observed. --fail needs a --note. --human asserts that a
         PERSON approved it and needs a token with the `human` scope — an agent
         records what it saw, a person approves. --environment is REQUIRED when
         the check must pass in more than one: a bare verdict there does not say
         what you saw, and it is refused rather than filed against a guess.
  takomo check ls [--project P] [--initiative I|none] [--epic E] [--severity S] [--layer L]
         `--initiative none` finds the checks no initiative claims: the gap
         between what was agreed and what got written down.
  takomo check new TITLE [--initiative I] [--epic E] [--layer ui|api|other]
         [--severity blocking|advisory|low] [--glob G]... [--env SLUG]...
         [--body B | --body-file F|-] [--precondition P]
         --env declares where it must pass. Each case is then tracked per
         environment, so "verified on staging, never run on production" is
         expressible instead of collapsing into one verdict. Omit it for a check
         whose result does not depend on where it runs.
         ONE action, ONE entry precondition, ONE layer. A create form, a finalize
         step and a cancel action are three checks, not one.
  takomo check cases ID --case KEY[::LABEL]... | --file F|-   [--keep]
         file the generated case set. Filing REPLACES it: a case the new set
         drops is retired (its verdict history kept), one that returns is
         revived. --keep extends instead. --file takes the JSON a model
         generator emits, which is where case sets actually come from.
  takomo check show ID [--cases]
  takomo check set ID [--initiative I|--no-initiative] [--env SLUG]... [--no-env]
         --env REPLACES the declared set; --no-env clears it. Undeclaring an
         environment KEEPS the verdicts recorded there, so narrowing what must
         pass never discards evidence.
  takomo check rm ID               archive it; cases and verdicts are kept
  takomo coverage [--project P | --initiative I]
         per project, or "do the tests we agreed on still pass" per initiative.
  takomo gate [--project P]        can this ship? exits non-zero when blocked.

Environments (where a check can be run — Takomo stores this and runs none of it):
  takomo env ls [--project P] [--kind K] [--archived]
  takomo env new SLUG [--name N] [--kind local|ephemeral|shared|staging|production|other]
         [--base-url U] [--bring-up C] [--teardown C]
         [--data-state seeded|empty|production_like|unknown]
         [--writable|--read-only] [--credentials-hint H] [--notes N]
         --credentials-hint is a POINTER to where a credential lives
         ("env:STAGING_TOKEN", a vault path, a runbook URL) and never the
         credential: every token with `read` can see it. kind=production
         defaults to read-only.
  takomo env show ID   ·   takomo env set ID [...]   ·   takomo env rm ID
         A slug cannot be renamed — checks and tool calls address an environment
         by it, so a rename would break every reference silently.

Portability & observability:
  takomo export [--project P] [--out FILE]   JSONL of tickets + comments + deps
  takomo import --from takomo|beads|beans PATH [--project P]
         load data in (Idempotency-Key = origin id, so re-import is safe);
         takomo FILE round-trips `takomo export`; beans PATH is a repo/.beans dir
  takomo watch  [--project P] [--since N]     tail the event log, printing new events
  takomo metrics                              ticket/claim/event counts for the store

Any --fence is auto-included from the local claim; transitions print the
allowed moves and a remedy when the workflow rejects them.
EOF
}

main() {
  CMD_ARGV=("$@")
  local cmd=${1:-help}
  if [ $# -gt 0 ]; then shift; fi
  case "$cmd" in
    help|-h|--help) cmd_help; return ;;
    init)    cmd_init "$@"; return ;;
  esac
  require_env
  case "$cmd" in
    whoami)  cmd_whoami "$@" ;;
    token)   cmd_token "$@" ;;
    project) cmd_project "$@" ;;
    new)     cmd_new "$@" ;;
    ls|list) cmd_ls "$@" ;;
    ready)   cmd_ready "$@" ;;
    roadmap) cmd_roadmap "$@" ;;
    impact) cmd_impact "$@" ;;
    show)    cmd_show "$@" ;;
    claim)   cmd_claim "$@" ;;
    next)    cmd_next "$@" ;;
    start)   cmd_start "$@" ;;
    done)    cmd_done "$@" ;;
    block)   cmd_block "$@" ;;
    cancel)  cmd_cancel "$@" ;;
    move)    cmd_move "$@" ;;
    comment) cmd_comment "$@" ;;
    link)    cmd_link "$@" ;;
    tag)     cmd_tag "$@" ;;
    person)  cmd_person "$@" ;;
    user)    cmd_user "$@" ;;
    dep)     cmd_dep "$@" ;;
    deps)    cmd_deps "$@" ;;
    archive) cmd_archive "$@" ;;
    unarchive) cmd_unarchive "$@" ;;
    promote) cmd_promote "$@" ;;
    release) cmd_release "$@" ;;
    initiative|ini) cmd_initiative "$@" ;;
    mindmap|mm)  cmd_mindmap "$@" ;;
    check)   cmd_check "$@" ;;
    env|environment) cmd_env "$@" ;;
    verify)  cmd_verify "$@" ;;
    verdict) cmd_verdict "$@" ;;
    coverage) cmd_coverage "$@" ;;
    gate)    cmd_gate "$@" ;;
    ask)         cmd_ask "$@" ;;
    answer)      cmd_answer "$@" ;;
    answer-link) cmd_answer_link "$@" ;;
    questions)   cmd_questions "$@" ;;
    assign)      cmd_assign "$@" ;;
    withdraw)    cmd_withdraw "$@" ;;
    reopen)      cmd_reopen "$@" ;;
    reply)       cmd_reply "$@" ;;
    options)     cmd_options "$@" ;;
    share)   cmd_share "$@" ;;
    export)  cmd_export "$@" ;;
    import)  cmd_import "$@" ;;
    watch)   cmd_watch "$@" ;;
    metrics) cmd_metrics "$@" ;;
    *) die "unknown command '$cmd' (try: takomo help)" ;;
  esac
}

main "$@"
