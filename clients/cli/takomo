if os.environ.get("TS_EXP"): d["expires_in_seconds"] = int(os.environ["TS_EXP"])
if os.environ.get("TS_OT"): d["on_timeout"] = os.environ["TS_OT"]
if os.environ.get("TS_FENCE"): d["fence"] = int(os.environ["TS_FENCE"])
opts = [l for l in os.environ.get("TS_OPTS","").splitlines() if l]
descs = [l for l in os.environ.get("TS_OPTDESCS","").splitlines() if l]
if opts:
    # pair options with descriptions when provided 1:1, else send plain strings
