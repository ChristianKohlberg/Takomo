# The envelope carries `total`; older servers answered with a bare array, so
# accept both rather than break against an instance that has not been upgraded.
if isinstance(d, list):
    items, total = d, None
else:
    items, total = d.get("items", []), d.get("total")
if not items:
    print("(ready queue empty)"); sys.exit()
def trunc(s, n): return s if len(s) <= n else s[:n-1] + "…"
print(f"{'ID':<14} {'PRI':<8} {'TYPE':<6} TITLE")
for t in items:
    print(f"{t['id']:<14} {t.get('priority',''):<8} {t.get('type',''):<6} {trunc(t.get('title',''),60)}")
