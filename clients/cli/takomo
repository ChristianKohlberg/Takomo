if os.environ.get("TS_RECNOTE", ""): d["recommended_note"] = os.environ["TS_RECNOTE"]
if os.environ.get("TS_REASON", ""):  d["reason"] = os.environ["TS_REASON"]
print(json.dumps(d))
PY
)
  api POST "/v1/questions/$(urlenc "$id")/options" "$data" >/dev/null
