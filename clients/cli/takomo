  local id=${1:-}; [ -n "$id" ] || die "dep: ID is required"; shift
  local blocked_by=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --blocked-by) blocked_by=$2; shift 2 ;;
      *) die "dep: unknown flag $1" ;;
    esac
  done
  [ -n "$blocked_by" ] || die "dep: --blocked-by OTHER is required"
  local fence; fence=$(fence_load "$id")
  local data; data=$(TS_BB="$blocked_by" TS_FENCE="$fence" python3 <<'PY'
import json, os
d = {"blocked_by": os.environ["TS_BB"]}
if os.environ.get("TS_FENCE",""): d["fence"] = int(os.environ["TS_FENCE"])
print(json.dumps(d))
PY
)
  api POST "/v1/tickets/$(urlenc "$id")/deps" "$data" >/dev/null
  echo "$id now blocked_by $blocked_by"
}

cmd_archive() {
  local id="" state="" project=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --state)   state=$2; shift 2 ;;
      --project) project=$2; shift 2 ;;
      -*) die "archive: unknown flag $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "archive: unexpected argument '$1'"; fi; shift ;;
    esac
  done
  if [ -n "$state" ]; then
    [ -z "$id" ] || die "archive: give either an ID or --state, not both"
    case "$state" in done|cancelled) ;; *) die "archive: --state must be 'done' or 'cancelled'" ;; esac
    project=$(resolve_project "$project")
    # Page through the (active) tickets in that terminal state and archive each.
    local cursor="" n=0
    while :; do
      local q
      q="?project=$(urlenc "$project")&state=$(urlenc "$state")&limit=200"
      [ -n "$cursor" ] && q="$q&cursor=$(urlenc "$cursor")"
      api GET "/v1/tickets$q" >/dev/null
      local ids; ids=$(python3 -c 'import json,sys; print("\n".join(t["id"] for t in json.load(open(sys.argv[1])).get("items",[])))' "$REQ_OUT")
      local tid
      while IFS= read -r tid; do
        [ -n "$tid" ] || continue
        api POST "/v1/tickets/$(urlenc "$tid")/archive" '{}' >/dev/null
        n=$((n + 1))
      done <<< "$ids"
      cursor=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("next_cursor") or "")' "$REQ_OUT")
      [ -n "$cursor" ] || break
    done
    echo "archived $n ticket(s) in state $state"
    return
  fi
  [ -n "$id" ] || die "archive: ID (or --state done|cancelled) is required"
  api POST "/v1/tickets/$(urlenc "$id")/archive" '{}' >/dev/null
  echo "archived $id"
}

cmd_unarchive() {
  local id=${1:-}; [ -n "$id" ] || die "unarchive: ID is required"
  api POST "/v1/tickets/$(urlenc "$id")/unarchive" '{}' >/dev/null
  echo "unarchived $id"
}

cmd_promote() {
  local id=${1:-}; [ -n "$id" ] || die "promote: usage: takomo promote ID TARGET [--url U] [--ref R] [--note N]"; shift
  local target="" url="" ref="" note=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --url)  url=$2; shift 2 ;;
      --ref)  ref=$2; shift 2 ;;
      --note) note=$2; shift 2 ;;
      -*) die "promote: unknown flag $1" ;;
      *) if [ -z "$target" ]; then target=$1; else die "promote: unexpected argument '$1'"; fi; shift ;;
    esac
  done
  [ -n "$target" ] || die "promote: TARGET is required (e.g. staging, production, published)"
  local data; data=$(TS_T="$target" TS_URL="$url" TS_REF="$ref" TS_NOTE="$note" python3 -c '
import json, os
d = {"target": os.environ["TS_T"]}
for env, key in (("TS_URL","url"),("TS_REF","ref"),("TS_NOTE","note")):
    v = os.environ.get(env, "")
    if v: d[key] = v
print(json.dumps(d))')
  api POST "/v1/tickets/$(urlenc "$id")/promote" "$data" >/dev/null
  echo "promoted $id → $target"
}

cmd_deps() {
  local id="" blocks="" tree=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --blocks) blocks=1; shift ;;
      --tree)   tree=1; shift ;;
      -*) die "deps: unknown flag $1" ;;
      *) if [ -z "$id" ]; then id=$1; else die "deps: unexpected argument '$1'"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "deps: ID is required"
  local dir="blocked_by"; [ -n "$blocks" ] && dir="blocks"
  local trans="false"; [ -n "$tree" ] && trans="true"
  api GET "/v1/tickets/$(urlenc "$id")/deps?direction=$dir&transitive=$trans" >/dev/null
  TS_TREE="$tree" python3 - "$REQ_OUT" <<'PY'
import json, os, sys
d = json.load(open(sys.argv[1]))
root = d["root"]; direction = d["direction"]; tree = bool(os.environ.get("TS_TREE"))
nodes = {n["id"]: n for n in d.get("nodes", [])}
edges = d.get("edges", [])
def label(nid):
    n = nodes.get(nid)
    return nid if not n else f"{nid}  [{n.get('state','')}]  {n.get('title','')}"
if direction == "blocked_by":
    def neigh(nid): return [e["blocked_by"] for e in edges if e["ticket"] == nid]
    print(f"{root} is blocked by:")
else:
    def neigh(nid): return [e["ticket"] for e in edges if e["blocked_by"] == nid]
    print(f"{root} blocks:")
if tree:
    seen = {root}
    def walk(nid, depth, path):
        for m in sorted(neigh(nid)):
            indent = "  " * (depth + 1)
            if m in path:
                print(indent + label(m) + "  (cycle)"); continue
            if m in seen:
                print(indent + label(m) + "  (seen above)"); continue
            print(indent + label(m)); seen.add(m)
            walk(m, depth + 1, path | {m})
    walk(root, 0, {root})
else:
    ns = sorted(neigh(root))
    if not ns:
        print("  (none)")
    for m in ns:
        print("  " + label(m))
PY
}

cmd_release() {
  local id=${1:-} reason=${2:-released via takomo}
  [ -n "$id" ] || die "release: ID is required"
  local fence; fence=$(fence_load "$id")
  [ -n "$fence" ] || die "release: no local fence for $id; pass --fence via claim first or release manually"
  local data; data=$(TS_F="$fence" TS_R="$reason" python3 -c \
    'import json,os; print(json.dumps({"fence":int(os.environ["TS_F"]),"reason":os.environ["TS_R"]}))')
  api POST "/v1/tickets/$(urlenc "$id")/release" "$data" >/dev/null
  fence_clear "$id"
  echo "released $id"
}

# --- initiatives -------------------------------------------------------------
# An initiative is the one thing in the store that is NOT work: an idea being
# nurtured — a product direction, the residue of a good conversation — fed by
# appending entries over time, each recording where it came from. No claim, no
# lease, no ready queue; `status` is a label (open|parked|distilled), not a state
# machine, and entries are append-only on every surface.
#
# These verbs are deliberately not parity with the other two surfaces. MCP came
# first because the thing that produces an initiative is an agent in a
# conversation, and the browser owns the document: /initiatives renders three
# panes from `view` entries and has an editor that knows about citation marks.
# Prose written through shell flags is exactly what that editor exists to avoid,
# so writing a pane stays there. What is left is the subset a repo-bound human
# reaches for — open one, feed it, find it, read it — plus the two things a shell
# does better than a textarea: piping prose in from a file, and attaching a
# document that is already on disk.
cmd_initiative() {
  local sub=${1:-}
  [ -n "$sub" ] || die "initiative: usage: takomo initiative new|append|ls|show|set ..."
  shift
  case "$sub" in
    new|open)   cmd_initiative_new "$@" ;;
    append|add) cmd_initiative_append "$@" ;;
    ls|list)    cmd_initiative_ls "$@" ;;
    show)       cmd_initiative_show "$@" ;;
    set)        cmd_initiative_set "$@" ;;
    *) die "initiative: unknown subcommand '$sub' (new|append|ls|show|set)" ;;
  esac
}

cmd_initiative_new() {
  local project="" summary="" status="" title=""
  local -a labels=()
  local -a tags=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project=$2; shift 2 ;;
      --summary) summary=$2; shift 2 ;;
      --status)  status=$2; shift 2 ;;
      --label)   labels+=("$2"); shift 2 ;;
      --tag)     tags+=("$2"); shift 2 ;;
      --) shift; break ;;
      -*) die "initiative new: unknown flag $1" ;;
      *) title=$1; shift ;;
    esac
  done
  [ -n "$title" ] || die "initiative new: TITLE is required"
  project=$(resolve_project "$project")
  local data
  data=$(TS_PROJECT="$project" TS_TITLE="$title" TS_SUMMARY="$summary" TS_STATUS="$status" \
    TS_LABELS="$(printf '%s\n' "${labels[@]+"${labels[@]}"}")" \
    TS_TAGS="$(printf '%s\n' "${tags[@]+"${tags[@]}"}")" python3 <<'PY'
import json, os
d = {"project": os.environ["TS_PROJECT"], "title": os.environ["TS_TITLE"]}
for env, key in (("TS_SUMMARY", "summary"), ("TS_STATUS", "status")):
    v = os.environ.get(env, "").strip()
    if v: d[key] = v
labels = [l for l in os.environ.get("TS_LABELS", "").splitlines() if l.strip()]
if labels: d["labels"] = labels
tags = [t for t in os.environ.get("TS_TAGS", "").splitlines() if t.strip()]
if tags: d["tags"] = tags
print(json.dumps(d))
PY
)
  api POST /v1/initiatives "$data" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
print(f"opened {d['id']}  [{d.get('status','')}]  {d.get('title','')}")
print(f"\nfeed it, and say where each contribution came from:")
print(f"  takomo initiative append {d['id']} --kind research --source 'WHERE THIS CAME FROM' --text '…'")
PY
}

# Append one contribution. --source is required for the same reason it is on the
# MCP tool: an entry whose origin nobody recorded is text nobody can weigh later.
#
# The body arrives as --text, or from a file (or stdin) with --text-file, which
# is how a shell escapes writing prose in flags. --attach uploads bytes already
# on disk; JSON cannot carry them, so they go up base64-encoded and the server
# decodes before measuring, meaning its caps bound the real payload.
cmd_initiative_append() {
  local id=${1:-}
  [ -n "$id" ] || die "initiative append: usage: takomo initiative append ID --kind K --source S [--text T | --text-file F] [--title T] [--source-uri U] [--origin-at RFC3339] [--origin] [--attach FILE] [--mime M] [--filename N]"
  shift
  local kind="" title="" text="" textfile="" source="" source_uri="" origin_at="" origin=""
  local attach="" mime="" filename="" have_text=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind)       kind=$2; shift 2 ;;
      --title)      title=$2; shift 2 ;;
      --text)       text=$2; have_text=1; shift 2 ;;
      --text-file)  textfile=$2; shift 2 ;;
      --source)     source=$2; shift 2 ;;
      --source-uri) source_uri=$2; shift 2 ;;
      --origin-at)  origin_at=$2; shift 2 ;;
      --origin)     origin=1; shift ;;
      --attach)     attach=$2; shift 2 ;;
      --mime)       mime=$2; shift 2 ;;
      --filename)   filename=$2; shift 2 ;;
      *) die "initiative append: unknown flag $1" ;;
    esac
  done
  [ -n "$kind" ] || die "initiative append: --kind is required (note, research, feedback, transcript, document — the vocabulary is open; pick a word that says what kind of input this is)"
  [ -n "$source" ] || die "initiative append: --source is required; an entry whose origin nobody recorded is text nobody can weigh later"
  [ -n "$have_text" ] && [ -n "$textfile" ] && die "initiative append: give either --text or --text-file, not both"
  [ -n "$have_text" ] || [ -n "$textfile" ] || [ -n "$attach" ] || \
    die "initiative append: nothing to append; give --text, --text-file, or --attach"

  # Both bodies are read by python from a path rather than passed as an argument:
  # a document is not bounded by what fits in an environment variable, and reading
  # the file preserves it exactly, trailing newline included.
  local tmptext=""
  if [ "$textfile" = "-" ]; then
    tmptext=$(mktemp); cat > "$tmptext"; textfile=$tmptext
  elif [ -n "$textfile" ]; then
    [ -r "$textfile" ] || die "initiative append: cannot read --text-file '$textfile'"
  fi
  [ -z "$attach" ] || [ -r "$attach" ] || die "initiative append: cannot read --attach '$attach'"

  local data
  data=$(TS_KIND="$kind" TS_TITLE="$title" TS_TEXT="$text" TS_TEXTFILE="$textfile" \
    TS_SOURCE="$source" TS_SOURCE_URI="$source_uri" TS_ORIGIN_AT="$origin_at" \
    TS_ORIGIN="$origin" TS_ATTACH="$attach" TS_MIME="$mime" TS_FILENAME="$filename" \
    python3 <<'PY'
import base64, json, os
d = {"kind": os.environ["TS_KIND"], "source": os.environ["TS_SOURCE"]}
tf = os.environ.get("TS_TEXTFILE", "")
if tf:
    d["text"] = open(tf, encoding="utf-8").read()
elif os.environ.get("TS_TEXT", ""):
    d["text"] = os.environ["TS_TEXT"]
for env, key in (("TS_TITLE", "title"), ("TS_SOURCE_URI", "source_uri"),
                 ("TS_ORIGIN_AT", "origin_at"), ("TS_MIME", "mime")):
    v = os.environ.get(env, "").strip()
    if v: d[key] = v
att = os.environ.get("TS_ATTACH", "")
if att:
    d["content_base64"] = base64.b64encode(open(att, "rb").read()).decode()
    # The server keeps whatever name it is told; default to the file's own rather
    # than making the caller retype it.
    d["filename"] = os.environ.get("TS_FILENAME", "").strip() or os.path.basename(att)
elif os.environ.get("TS_FILENAME", "").strip():
    d["filename"] = os.environ["TS_FILENAME"].strip()
if os.environ.get("TS_ORIGIN", ""):
    d["meta"] = {"origin": True}
print(json.dumps(d))
PY
)
  [ -n "$tmptext" ] && rm -f "$tmptext"
  api POST "/v1/initiatives/$(urlenc "$id")/entries" "$data" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
e, ini = d.get("entry") or {}, d.get("initiative") or {}
r = ini.get("rollup") or {}
first = (e.get("text") or "").strip().split("\n")[0]
if len(first) > 60: first = first[:59] + "…"
what = e.get("title") or first or e.get("filename", "")
print(f"appended {e.get('id')}  [{e.get('kind')}]  {what}")
print(f"  source: {e.get('source','')}")
if e.get("has_content"):
    print(f"  attached: {e.get('filename','')}  {e.get('content_bytes',0)} bytes  {e.get('mime') or '(no mime)'}")
print(f"  {ini.get('id')} now holds {r.get('entries',0)} entr{'y' if r.get('entries')==1 else 'ies'}, {r.get('chars',0)} chars")
PY
}

cmd_initiative_ls() {
  local project="" status="" q="" label="" tag="" limit="" cursor=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project=$2; shift 2 ;;
      --status)  status=$2; shift 2 ;;
      --label)   label=$2; shift 2 ;;
      --tag)     tag=$2; shift 2 ;;
      --limit)   limit=$2; shift 2 ;;
      --cursor)  cursor=$2; shift 2 ;;
      -q)        q=$2; shift 2 ;;
      *) die "initiative ls: unknown flag $1" ;;
    esac
  done
  [ -z "$limit" ] || is_uint "$limit" || die "initiative ls: --limit must be a positive integer"
  local qs="?"
  # Unlike `ls`, an initiative list without a project is legitimate — a token may
  # legitimately span projects and the store filters to what it is allowed to see.
  [ -z "$project" ] && [ -n "${TAKOMO_PROJECT:-}" ] && project=$TAKOMO_PROJECT
  [ -n "$project" ] && qs="$qs&project=$(urlenc "$project")"
  [ -n "$status" ] && qs="$qs&status=$(urlenc "$status")"
  [ -n "$q" ] && qs="$qs&q=$(urlenc "$q")"
  [ -n "$label" ] && qs="$qs&label=$(urlenc "$label")"
  [ -n "$tag" ] && qs="$qs&tag=$(urlenc "$tag")"
  [ -n "$limit" ] && qs="$qs&limit=$limit"
  [ -n "$cursor" ] && qs="$qs&cursor=$(urlenc "$cursor")"
  api GET "/v1/initiatives$qs" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
items = d.get("items") or []
if not items:
    print("(no initiatives)")
    raise SystemExit(0)
def trunc(s, n):
    s = s or ""
    return s if len(s) <= n else s[: n - 1] + "…"
for i in items:
    r = i.get("rollup") or {}
    last = (r.get("last_entry_at") or "")[:10]
    meta = f"{r.get('entries', 0)} entr{'y' if r.get('entries') == 1 else 'ies'}"
    if last: meta += f", last {last}"
    # What the document wants from a person, said in words rather than as two
    # bare numbers: this is the line that decides which one you open next.
    notes, amend = r.get("open_notes", 0), r.get("pending_amendments", 0)
    waiting = []
    if amend: waiting.append(f"{amend} suggested change{'' if amend == 1 else 's'} to decide")
    if notes: waiting.append(f"{notes} open note{'' if notes == 1 else 's'}")
    print(f"{i['id']}  [{i.get('status','')}]  {trunc(i.get('title',''), 52)}")
    print(f"    {meta}")
    if waiting: print(f"    waiting: {', '.join(waiting)}")
if d.get("next_cursor"):
    print(f"\nmore: --cursor {d['next_cursor']}")
PY
}

# Read one: the description, then the collection newest first. Entry text is
# printed whole — the point of reading an initiative is the prose, and a
# collection you can only see the first line of is the pile the panes exist to
# escape. Attachment bytes are not fetched; the content route serves those.
cmd_initiative_show() {
  local id=${1:-}
  [ -n "$id" ] || die "initiative show: usage: takomo initiative show ID [--limit N] [--cursor C]"
  shift
  local limit="" cursor=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --limit)  limit=$2; shift 2 ;;
      --cursor) cursor=$2; shift 2 ;;
      *) die "initiative show: unknown flag $1" ;;
    esac
  done
  [ -z "$limit" ] || is_uint "$limit" || die "initiative show: --limit must be a positive integer"
  api GET "/v1/initiatives/$(urlenc "$id")" >/dev/null
  local ini_file; ini_file=$(mktemp); cp "$REQ_OUT" "$ini_file"
  local qs="?"
  [ -n "$limit" ] && qs="$qs&limit=$limit"
  [ -n "$cursor" ] && qs="$qs&cursor=$(urlenc "$cursor")"
  api GET "/v1/initiatives/$(urlenc "$id")/entries$qs" >/dev/null
  python3 - "$ini_file" "$REQ_OUT" <<'PY'
import json, sys, textwrap
ini = json.load(open(sys.argv[1]))
ent = json.load(open(sys.argv[2]))
r = ini.get("rollup") or {}
print(f"{ini['id']}  [{ini.get('status','')}]  {ini.get('title','')}")
print(f"project: {ini.get('project','')}   opened by {ini.get('created_by','')} on {(ini.get('created_at') or '')[:10]}")
if ini.get("summary"):
    print("\n" + "\n".join(textwrap.wrap(ini["summary"], 78)))
bits = []
if ini.get("labels"): bits.append(" ".join(ini["labels"]))
if ini.get("tags"): bits.append(" ".join("#" + t for t in ini["tags"]))
if bits: print("\n" + "   ".join(bits))
print(f"\n--- {r.get('entries', 0)} entr{'y' if r.get('entries') == 1 else 'ies'}, "
      f"{r.get('chars', 0)} chars, {r.get('attachments', 0)} attachment(s) ---")
for e in ent.get("items") or []:
    head = f"\n{e['id']}  [{e.get('kind','')}]"
    if e.get("title"): head += f"  {e['title']}"
    print(head)
    origin = (e.get("meta") or {}).get("origin") if isinstance(e.get("meta"), dict) else None
    pane = (e.get("meta") or {}).get("pane") if isinstance(e.get("meta"), dict) else None
    marks = []
    if origin: marks.append("the words it arrived in")
    if pane: marks.append(f"{pane} pane")
    line = f"  {e.get('author','')} on {(e.get('created_at') or '')[:10]}   source: {e.get('source','')}"
    if marks: line += "   (" + ", ".join(marks) + ")"
    print(line)
    if e.get("source_uri"): print(f"  {e['source_uri']}")
    if e.get("has_content"):
        print(f"  attached: {e.get('filename','')}  {e.get('content_bytes',0)} bytes  {e.get('mime') or '(no mime)'}")
    # rstrip so a file that ends in a newline — which every well-formed one does —
    # does not print a trailing blank line under its entry.
    for para in (e.get("text") or "").rstrip().split("\n"):
        print("\n".join(textwrap.wrap(para, 76, initial_indent="  ", subsequent_indent="  ")) if para.strip() else "")
if ent.get("next_cursor"):
    print(f"\nmore: --cursor {ent['next_cursor']}")
PY
  rm -f "$ini_file"
}

# Edit how an initiative is DESCRIBED — never its entries, which are append-only
# on every surface. Parking one, or marking it distilled once its substance became
# tickets, is the lifecycle move a shell actually wants.
cmd_initiative_set() {
  local id=${1:-}
  [ -n "$id" ] || die "initiative set: usage: takomo initiative set ID [--title T] [--summary S] [--status open|parked|distilled] [--label L]... [--tag T]..."
  shift
  local title="" summary="" status="" have_labels="" have_tags=""
  local -a labels=()
  local -a tags=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --title)   title=$2; shift 2 ;;
      --summary) summary=$2; shift 2 ;;
      --status)  status=$2; shift 2 ;;
      --label)   labels+=("$2"); have_labels=1; shift 2 ;;
      --tag)     tags+=("$2"); have_tags=1; shift 2 ;;
      *) die "initiative set: unknown flag $1" ;;
    esac
  done
  [ -n "$title$summary$status$have_labels$have_tags" ] || \
    die "initiative set: give at least one of --title --summary --status --label --tag"
  # labels and tags are whole-list replaces, as they are on the API; repeat the
  # flag to give the full set you want.
  local data
  data=$(TS_TITLE="$title" TS_SUMMARY="$summary" TS_STATUS="$status" \
    TS_HAVE_LABELS="$have_labels" TS_HAVE_TAGS="$have_tags" \
    TS_LABELS="$(printf '%s\n' "${labels[@]+"${labels[@]}"}")" \
    TS_TAGS="$(printf '%s\n' "${tags[@]+"${tags[@]}"}")" python3 <<'PY'
import json, os
d = {}
for env, key in (("TS_TITLE", "title"), ("TS_SUMMARY", "summary"), ("TS_STATUS", "status")):
    v = os.environ.get(env, "")
    if v.strip(): d[key] = v
if os.environ.get("TS_HAVE_LABELS", ""):
    d["labels"] = [l for l in os.environ.get("TS_LABELS", "").splitlines() if l.strip()]
if os.environ.get("TS_HAVE_TAGS", ""):
    d["tags"] = [t for t in os.environ.get("TS_TAGS", "").splitlines() if t.strip()]
print(json.dumps(d))
PY
)
  api PATCH "/v1/initiatives/$(urlenc "$id")" "$data" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
print(f"{d['id']}  [{d.get('status','')}]  {d.get('title','')}")
PY
}

# --- checks and environments -------------------------------------------------
# Checklist is how a "done" claim becomes a verified one, and the loop it exists
# to serve runs in a shell as often as it runs over MCP: find what needs
# re-verifying, read where to run it, run it, say what happened.
#
# So the four verbs here are the loop, not CRUD parity — `takomo verify` is the
# worklist, `takomo verdict` is the report back, `takomo env ls` is where to go.
# Filing a check and its cases is also here, because a check is a sentence and a
# case set is generated: both are things a shell hands over from a file or a
# pipeline better than a textarea does.
#
# Takomo stores; the caller computes. Nothing below generates a case model or
# judges a coverage claim — the store does not, and neither does this.

cmd_check() {
  local sub=${1:-}
  [ -n "$sub" ] || die "check: usage: takomo check ls|new|show|set|cases|rm ..."
  shift
  case "$sub" in
    ls|list)          cmd_check_ls "$@" ;;
    new|file)         cmd_check_new "$@" ;;
    show)             cmd_check_show "$@" ;;
    set)              cmd_check_set "$@" ;;
    cases)            cmd_check_cases "$@" ;;
    rm|archive)       cmd_check_archive "$@" ;;
    *) die "check: unknown subcommand '$sub' (ls|new|show|set|cases|rm)" ;;
  esac
}

cmd_check_ls() {
  local project="" initiative="" epic="" severity="" layer="" archived="" limit=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project)    project=$2; shift 2 ;;
      --initiative) initiative=$2; shift 2 ;;
      --epic)       epic=$2; shift 2 ;;
      --severity)   severity=$2; shift 2 ;;
      --layer)      layer=$2; shift 2 ;;
      --archived)   archived=1; shift ;;
      --limit)      limit=$2; shift 2 ;;
      -*) die "check ls: unknown flag $1" ;;
      *)  die "check ls: unexpected argument '$1'" ;;
    esac
  done
  project=$(resolve_project "$project")
  [ -z "$limit" ] || is_uint "$limit" || die "check ls: --limit must be a positive integer"
  local qs="" sep="?"
  [ -n "$initiative" ] && { qs="$qs${sep}initiative=$(urlenc "$initiative")"; sep="&"; }
  [ -n "$epic" ] && { qs="$qs${sep}epic=$(urlenc "$epic")"; sep="&"; }
  [ -n "$severity" ] && { qs="$qs${sep}severity=$(urlenc "$severity")"; sep="&"; }
  [ -n "$layer" ] && { qs="$qs${sep}layer=$(urlenc "$layer")"; sep="&"; }
  [ -n "$archived" ] && { qs="$qs${sep}archived=include"; sep="&"; }
  [ -n "$limit" ] && { qs="$qs${sep}limit=$limit"; sep="&"; }
  api GET "/v1/projects/$(urlenc "$project")/checks$qs" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
items = d.get("items", [])
if not items:
    print("(no checks)"); sys.exit()
print(f"{'ID':<14} {'SEV':<9} {'LAYER':<6} {'CASES':<22} TITLE")
for c in items:
    n = c.get("cases") or {}
    # The spread, not just a total: "12 cases" says nothing, while "8 ok · 3
    # stale · 1 never" is the whole reason to look at the list.
    parts = []
    for key, word in (("approved", "ok"), ("verified", "ok"), ("stale", "stale"),
                      ("failed", "fail"), ("never", "never"), ("unreachable", "n/a")):
        v = n.get(key) or 0
        if v: parts.append((word, v))
    merged = {}
    for word, v in parts: merged[word] = merged.get(word, 0) + v
    spread = " · ".join(f"{v} {w}" for w, v in merged.items()) or "no cases"
    print(f"{c.get('id',''):<14} {c.get('severity',''):<9} {c.get('layer',''):<6} {spread:<22} {c.get('title','')}")
note = d.get("note")
if note: print(f"\n{d.get('total')} total. {note}")
PY
}

cmd_check_new() {
  local project="" title="" initiative="" epic="" layer="" severity=""
  local body="" have_body="" bodyfile="" precondition=""
  local -a globs=()
  local -a envs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --project)      project=$2; shift 2 ;;
      --initiative)   initiative=$2; shift 2 ;;
      --epic)         epic=$2; shift 2 ;;
      --layer)        layer=$2; shift 2 ;;
      --severity)     severity=$2; shift 2 ;;
      --body)         body=$2; have_body=1; shift 2 ;;
      --body-file)    bodyfile=$2; shift 2 ;;
      --precondition) precondition=$2; shift 2 ;;
      --glob)         globs+=("$2"); shift 2 ;;
      --env)          envs+=("$2"); shift 2 ;;
      -*) die "check new: unknown flag $1" ;;
      *)  if [ -z "$title" ]; then title=$1; shift; else die "check new: unexpected argument '$1'"; fi ;;
    esac
  done
  [ -n "$title" ] || die "check new: usage: takomo check new TITLE [--initiative I] [--glob G]..."
  [ -n "$have_body" ] && [ -n "$bodyfile" ] && die "check new: give either --body or --body-file, not both"
  project=$(resolve_project "$project")
  # The traversal is prose and can be long; reading it from a path preserves it
  # exactly rather than squeezing it through an argument.
  local tmpbody=""
  if [ "$bodyfile" = "-" ]; then
    tmpbody=$(mktemp); cat > "$tmpbody"; bodyfile=$tmpbody
  elif [ -n "$bodyfile" ]; then
    [ -r "$bodyfile" ] || die "check new: cannot read --body-file '$bodyfile'"
  fi
  local data
  data=$(TS_TITLE="$title" TS_INI="$initiative" TS_EPIC="$epic" TS_LAYER="$layer" \
    TS_SEV="$severity" TS_BODY="$body" TS_BODYFILE="$bodyfile" TS_PRE="$precondition" \
    TS_GLOBS="$(printf '%s\n' "${globs[@]+"${globs[@]}"}")" \
    TS_ENVS="$(printf '%s\n' "${envs[@]+"${envs[@]}"}")" \
    python3 <<'PY'
import json, os
d = {"title": os.environ["TS_TITLE"]}
bf = os.environ.get("TS_BODYFILE", "")
if bf:
    d["body"] = open(bf, encoding="utf-8").read()
elif os.environ.get("TS_BODY", ""):
    d["body"] = os.environ["TS_BODY"]
for env, key in (("TS_INI", "initiative"), ("TS_EPIC", "epic"), ("TS_LAYER", "layer"),
                 ("TS_SEV", "severity"), ("TS_PRE", "precondition")):
    v = os.environ.get(env, "").strip()
    if v: d[key] = v
globs = [g for g in os.environ.get("TS_GLOBS", "").splitlines() if g.strip()]
if globs: d["globs"] = globs
envs = [e for e in os.environ.get("TS_ENVS", "").splitlines() if e.strip()]
if envs: d["environments"] = envs
print(json.dumps(d))
PY
)
  [ -n "$tmpbody" ] && rm -f "$tmpbody"
  api POST "/v1/projects/$(urlenc "$project")/checks" "$data" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
print(f"{d['id']}  [{d.get('severity','')}/{d.get('layer','')}]  {d.get('title','')}")
if d.get("initiative"): print(f"  initiative: {d['initiative']}")
print(f"\nNext: file the cases it crosses with —")
print(f"  takomo check cases {d['id']} --case 'entities=2' --case 'entities=3'")
PY
}

cmd_check_show() {
  local id=${1:-}; [ -n "$id" ] || die "check show: usage: takomo check show ID [--cases]"
  shift
  local cases=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --cases) cases=1; shift ;;
      -*) die "check show: unknown flag $1" ;;
      *)  die "check show: unexpected argument '$1'" ;;
    esac
  done
  api GET "/v1/checks/$(urlenc "$id")" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
print(f"{c['id']}  [{c.get('severity','')}/{c.get('layer','')}]  {c.get('title','')}")
if c.get("initiative"): print(f"initiative: {c['initiative']}")
if c.get("epic"):       print(f"epic:       {c['epic']}")
if c.get("precondition"): print(f"\nprecondition: {c['precondition']}")
if c.get("body"): print(f"\n{c['body']}")
if c.get("globs"): print(f"\nclaims: {', '.join(c['globs'])}")
# An orphaned glob is the worst failure this feature has — it reads as covered
# while matching nothing — so it is printed loudly rather than tucked away.
if c.get("orphan_globs"):
    print(f"ORPHANED (matched no file in the newest release): {', '.join(c['orphan_globs'])}")
p = c.get("policy") or {}
if p:
    print(f"\nverification: {p.get('verification')} (from {p.get('verification_from')})")
n = c.get("cases") or {}
if n: print("cases: " + " · ".join(f"{k} {v}" for k, v in n.items() if v))
# Where it must pass, and how each one stands. One line per environment
# because "verified" and "never run" living in the same number is the thing
# declaring environments exists to stop.
for e in c.get("environment_cases") or []:
    ec = e.get("cases") or {}
    spread = " · ".join(f"{k} {v}" for k, v in ec.items() if v and k != "total") or "no cases"
    print(f"  {e.get('slug',''):<14} {spread}")
PY
  if [ -n "$cases" ]; then
    api GET "/v1/checks/$(urlenc "$id")/cases" >/dev/null
    python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
items = d.get("items", [])
if not items: sys.exit()
print(f"\n{'CASE':<14} {'STATE':<12} KEY")
for c in items:
    print(f"{c.get('id',''):<14} {c.get('state',''):<12} {c.get('key','')}")
note = d.get("note")
if note: print(f"\n{d.get('total')} total. {note}")
PY
  fi
}

cmd_check_set() {
  local id=${1:-}; [ -n "$id" ] || die "check set: usage: takomo check set ID [--initiative I|--no-initiative] ..."
  shift
  local initiative="" clear_ini="" severity="" layer="" title="" set_envs=""
  local -a envs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --initiative)    initiative=$2; shift 2 ;;
      --no-initiative) clear_ini=1; shift ;;
      --severity)      severity=$2; shift 2 ;;
      --layer)         layer=$2; shift 2 ;;
      --title)         title=$2; shift 2 ;;
      --env)           envs+=("$2"); set_envs=1; shift 2 ;;
      --no-env)        set_envs=1; shift ;;
      -*) die "check set: unknown flag $1" ;;
      *)  die "check set: unexpected argument '$1'" ;;
    esac
  done
  [ -n "$initiative" ] && [ -n "$clear_ini" ] && \
    die "check set: give either --initiative or --no-initiative, not both"
  local data
  data=$(TS_INI="$initiative" TS_CLEAR="$clear_ini" TS_SEV="$severity" \
    TS_LAYER="$layer" TS_TITLE="$title" TS_SETENVS="$set_envs" \
    TS_ENVS="$(printf '%s\n' "${envs[@]+"${envs[@]}"}")" python3 <<'PY'
import json, os
d = {}
# Absent and null mean different things on this wire: null clears the link and
# resumes "no initiative", which is why --no-initiative is its own flag.
if os.environ.get("TS_CLEAR", ""):
    d["initiative"] = None
elif os.environ.get("TS_INI", "").strip():
    d["initiative"] = os.environ["TS_INI"].strip()
for env, key in (("TS_SEV", "severity"), ("TS_LAYER", "layer"), ("TS_TITLE", "title")):
    v = os.environ.get(env, "").strip()
    if v: d[key] = v
# --env REPLACES the declared set, and --no-env clears it. Undeclaring keeps
# whatever was recorded there, so this is narrowing what must pass rather than
# discarding evidence.
if os.environ.get("TS_SETENVS", ""):
    d["environments"] = [e for e in os.environ.get("TS_ENVS", "").splitlines() if e.strip()]
print(json.dumps(d))
PY
)
  [ "$data" = "{}" ] && die "check set: nothing to change"
  api PATCH "/v1/checks/$(urlenc "$id")" "$data" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
print(f"{c['id']}  [{c.get('severity','')}/{c.get('layer','')}]  {c.get('title','')}")
print(f"  initiative:   {c.get('initiative') or '(none)'}")
slugs = [e.get('slug','') for e in (c.get('environments') or [])]
print(f"  environments: {', '.join(slugs) or '(none — verified anywhere)'}")
PY
}

# File the case set. `--case key` or `--case key=label`, repeated; or `--file`
# for a JSON array, because a generated model comes out of a tool (PICT and
# friends) rather than out of a person's fingers.
cmd_check_cases() {
  local id=${1:-}; [ -n "$id" ] || die "check cases: usage: takomo check cases ID --case KEY[::LABEL]... | --file F"
  shift
  local file="" keep=""
  local -a cases=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --case)  cases+=("$2"); shift 2 ;;
      --file)  file=$2; shift 2 ;;
      --keep)  keep=1; shift ;;
      -*) die "check cases: unknown flag $1" ;;
      *)  die "check cases: unexpected argument '$1'" ;;
    esac
  done
  [ ${#cases[@]} -gt 0 ] || [ -n "$file" ] || \
    die "check cases: give --case KEY[::LABEL] (repeatable) or --file F"
  if [ "$file" = "-" ]; then
    local tmp; tmp=$(mktemp); cat > "$tmp"; file=$tmp
  elif [ -n "$file" ]; then
    [ -r "$file" ] || die "check cases: cannot read --file '$file'"
  fi
  local data
  data=$(TS_FILE="$file" TS_KEEP="$keep" \
    TS_CASES="$(printf '%s\n' "${cases[@]+"${cases[@]}"}")" python3 <<'PY'
import json, os, sys
f = os.environ.get("TS_FILE", "")
if f:
    raw = json.load(open(f, encoding="utf-8"))
    cases = raw.get("cases") if isinstance(raw, dict) else raw
    if not isinstance(cases, list):
        sys.exit("takomo: --file must hold a JSON array of cases, or {\"cases\": [...]}")
else:
    cases = []
    for line in os.environ.get("TS_CASES", "").splitlines():
        if not line.strip(): continue
        # `::`, not `=`. A case key is derived from its parameter assignment, so
        # the common shapes are `entities=2` and `vat=19` — splitting on `=`
        # would swallow the key at exactly the point it matters.
        key, _, label = line.partition("::")
        cases.append({"key": key.strip(), "label": label.strip()})
d = {"cases": cases}
# Filing REPLACES the set by default: a case the new set drops is retired, not
# deleted, and one that returns is revived. --keep extends instead, for a model
# being built up in pieces.
if os.environ.get("TS_KEEP", ""): d["prune"] = False
print(json.dumps(d))
PY
)
  api PUT "/v1/checks/$(urlenc "$id")/cases" "$data" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
print(f"added {d.get('added',0)} · updated {d.get('updated',0)} · "
      f"retired {d.get('retired',0)} · revived {d.get('revived',0)} · live {d.get('live',0)}")
PY
}

cmd_check_archive() {
  local id=${1:-}; [ -n "$id" ] || die "check archive: usage: takomo check rm ID"
  api DELETE "/v1/checks/$(urlenc "$id")" >/dev/null
  echo "archived $id (its cases and their verdict history are kept)"
}

# What needs re-verifying, split by who can clear it. Human time is the scarce
# resource — a hundred cases cost an agent minutes and a person most of a day —
# so the split is the answer, not a formatting choice.
cmd_verify() {
  local project=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project=$2; shift 2 ;;
      -*) die "verify: unknown flag $1" ;;
      *)  die "verify: unexpected argument '$1'" ;;
    esac
  done
  project=$(resolve_project "$project")
  api GET "/v1/projects/$(urlenc "$project")/checklist/worklist" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
rel = d.get("release") or {}
if rel: print(f"as of release {rel.get('id')} (seq {rel.get('seq')})\n")
empty = True
for side in ("agent", "human"):
    s = d.get(side) or {}
    items = s.get("items") or []
    if not items: continue
    empty = False
    mins = s.get("minutes")
    cost = f", ~{mins} min" if mins else ""
    print(f"--- {side}: {s.get('cases', 0)} case(s){cost} ---")
    show_env = any(i.get("environment_slug") for i in items)
    head = f"{'CASE':<14} {'REASON':<9} {'SEV':<9} "
    if show_env: head += f"{'WHERE':<12} "
    print(head + "CHECK")
    for i in items:
        label = i.get("case_label") or i.get("case_key") or ""
        row = f"{i.get('case',''):<14} {i.get('reason',''):<9} {i.get('severity',''):<9} "
        if show_env: row += f"{i.get('environment_slug') or '-':<12} "
        print(row + f"{i.get('check_title','')} — {label}")
    # The URL is on the item precisely so nobody has to look it up. One line per
    # DISTINCT environment: printing the first item's would read as the address
    # for every row above it.
    seen = {}
    for i in items:
        slug, url = i.get("environment_slug"), i.get("base_url")
        if slug and url and slug not in seen:
            seen[slug] = url
    for slug, url in sorted(seen.items()):
        print(f"    {slug}: {url}")
    print()
if empty:
    print("nothing to re-verify")
else:
    print("Report a result with:  takomo verdict CASE --pass|--fail --note '...'")
    print("A check that must pass in several environments also needs --environment SLUG.")
PY
}

# Report what you observed. An agent records what it saw; only a person's token
# may assert that a person approved a case, which is the same line ask-a-human
# draws — hence --human being a separate, deliberate flag.
cmd_verdict() {
  local case_id=${1:-}
  [ -n "$case_id" ] || die "verdict: usage: takomo verdict CASE --pass|--fail|--blocked|--unreachable [--note N]"
  shift
  local verdict="" note="" human="" release="" env=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --pass)        verdict=pass; shift ;;
      --fail)        verdict=fail; shift ;;
      --blocked)     verdict=blocked; shift ;;
      --unreachable) verdict=unreachable; shift ;;
      --verdict)     verdict=$2; shift 2 ;;
      --note)        note=$2; shift 2 ;;
      --human)       human=1; shift ;;
      --release)     release=$2; shift 2 ;;
      --environment|--env) env=$2; shift 2 ;;
      -*) die "verdict: unknown flag $1" ;;
      *)  die "verdict: unexpected argument '$1'" ;;
    esac
  done
  [ -n "$verdict" ] || die "verdict: say what you observed — --pass, --fail, --blocked or --unreachable"
  [ "$verdict" = "fail" ] && [ -z "$note" ] && \
    die "verdict: --fail needs --note saying what went wrong; a failure nobody described is one nobody can act on"
  local data
  data=$(TS_V="$verdict" TS_NOTE="$note" TS_HUMAN="$human" TS_REL="$release" \
    TS_ENV="$env" python3 <<'PY'
import json, os
d = {"verdict": os.environ["TS_V"]}
if os.environ.get("TS_NOTE", ""): d["note"] = os.environ["TS_NOTE"]
if os.environ.get("TS_REL", "").strip(): d["release"] = os.environ["TS_REL"].strip()
if os.environ.get("TS_HUMAN", ""): d["actor_kind"] = "human"
# Required when the check must pass in more than one environment. Omitted is
# fine for a check declaring one or none; the store refuses rather than guesses
# when it is genuinely ambiguous.
if os.environ.get("TS_ENV", "").strip(): d["environment"] = os.environ["TS_ENV"].strip()
print(json.dumps(d))
PY
)
  api POST "/v1/cases/$(urlenc "$case_id")/verdict" "$data" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
print(f"{c['id']}  {c.get('state','')}  {c.get('key','')}")
# With declared environments the case's own word is the WORST of them, so the
# per-environment line is what says whether there is anything left to do.
for e in c.get("environments") or []:
    print(f"  {e.get('slug',''):<14} {e.get('state','')}")
PY
}

cmd_coverage() {
  local project="" initiative=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project)    project=$2; shift 2 ;;
      --initiative) initiative=$2; shift 2 ;;
      -*) die "coverage: unknown flag $1" ;;
      *)  die "coverage: unexpected argument '$1'" ;;
    esac
  done
  # An initiative reads its own standing through its own sub-resource: "do the
  # tests we agreed on still pass" is a different question from "how covered is
  # this project", and they have different answers.
  if [ -n "$initiative" ]; then
    api GET "/v1/initiatives/$(urlenc "$initiative")/verification" >/dev/null
    python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
n = d.get("cases") or {}
print(f"{d.get('title','')}  ({d.get('checks',0)} check(s), {d.get('percent',0)}%)")
print(" · ".join(f"{k} {v}" for k, v in n.items() if v) or "no cases")
if d.get("last_verified_at"): print(f"last verified {d['last_verified_at']}")
if d.get("blocked"):
    print(f"BLOCKED: {d.get('blocking_outstanding',0)} blocking case(s) outstanding")
PY
    return
  fi
  project=$(resolve_project "$project")
  api GET "/v1/projects/$(urlenc "$project")/checklist/coverage" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
n = d.get("cases") or {}
print(f"{d.get('checks',0)} check(s), {d.get('percent',0)}% of verifiable cases")
print(" · ".join(f"{k} {v}" for k, v in n.items() if v) or "no cases")
rel = d.get("release") or {}
if rel: print(f"as of {rel.get('ref')} (seq {rel.get('seq')})")
PY
}

cmd_gate() {
  local project=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project=$2; shift 2 ;;
      -*) die "gate: unknown flag $1" ;;
      *)  die "gate: unexpected argument '$1'" ;;
    esac
  done
  project=$(resolve_project "$project")
  api GET "/v1/projects/$(urlenc "$project")/checklist/gate" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
b = d.get("blocking") or {}
if d.get("blocked"):
    print(f"BLOCKED — {b.get('agent_cases',0)} agent + {b.get('human_cases',0)} human "
          f"blocking case(s) outstanding")
    for i in (b.get("items") or [])[:20]:
        print(f"  {i.get('case','')}  {i.get('reason',''):<9} {i.get('check_title','')}")
else:
    print("clear — no blocking verification outstanding")
adv = d.get("advisory_outstanding") or 0
# Advisory nags rather than blocks: a gate that fires on everything gets
# overridden out of habit and stops meaning anything.
if adv: print(f"({adv} advisory case(s) outstanding — these do not block)")
sys.exit(1 if d.get("blocked") else 0)
PY
}

cmd_env() {
  local sub=${1:-}
  [ -n "$sub" ] || die "env: usage: takomo env ls|new|show|set|rm ..."
  shift
  case "$sub" in
    ls|list)    cmd_env_ls "$@" ;;
    new|file)   cmd_env_new "$@" ;;
    show)       cmd_env_show "$@" ;;
    set)        cmd_env_set "$@" ;;
    rm|archive) cmd_env_archive "$@" ;;
    *) die "env: unknown subcommand '$sub' (ls|new|show|set|rm)" ;;
  esac
}

cmd_env_ls() {
  local project="" kind="" archived=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project)  project=$2; shift 2 ;;
      --kind)     kind=$2; shift 2 ;;
      --archived) archived=1; shift ;;
