# person: ergonomic alias over the `person` tag kind. `takomo person add ada`
# is just `takomo tag new --kind person --handle ada`; ls/rm mirror it.
# `person` is retired, and says so.
#
# It was sugar over the project TAG registry — `person:<handle>` reference
# metadata on one project's tickets — which is a different thing from the people
# directory a decision can be addressed to. Two people-shaped commands, one of
# which quietly did not do what its name suggested: somebody typing
# `takomo person add ada` reasonably believed they had added Ada, and had instead
# written a registry row almost nothing reads.
#
# So there is one vocabulary now: `takomo user` is the directory, `takomo tag` is
# the reference. This shim stays because muscle memory deserves a signpost rather
# than "unknown command" — and because the two destinations are not
# interchangeable, so guessing for the caller would be worse than asking.
cmd_person() {
  local sub=${1:-}
  local hint="takomo person is retired: it managed 'person:<handle>' TAGS, not people.

  Add somebody a decision can be addressed to:  takomo user new HANDLE --name \"Full Name\"
  List those people:                            takomo user ls
  Tag a ticket with a person (reference only):   takomo tag add TICKET person:HANDLE
  List the tag registry:                        takomo tag ls --kind person

A user handle and a person: tag handle are the same spelling of the same person,
so the registry listing shows who is in the directory."
  case "$sub" in
    ls|list)
      # The one case with an unambiguous replacement worth running for them: the
      # directory is what somebody listing people almost always wanted.
      warn "takomo person ls is retired; showing the people directory (takomo user ls). For the tag registry: takomo tag ls --kind person"
      shift
      cmd_user_ls "$@"
      ;;
    *) die "$hint" ;;
  esac
}

# --- the people directory: who work can be addressed to ----------------------
#
# A user is not a login and grants nothing on its own; scopes are still what a
# credential may do. What it adds is addressing — a question waiting on Ada rather
# than on whoever holds expert:domain:billing. See docs/users.md.
cmd_user() {
  local sub=${1:-}
  [ -n "$sub" ] || die "user: usage: takomo user ls [--project P] [-q TEXT] [--all]
       takomo user show HANDLE
       takomo user new HANDLE [--name \"Full Name\"] [--email a@b.c] [--project P]...
       takomo user set HANDLE [--name ...] [--email ...|--no-email]
       takomo user disable HANDLE   |   takomo user enable HANDLE
       takomo user member HANDLE PROJECT   |   takomo user unmember HANDLE PROJECT"
  shift
  case "$sub" in
    ls|list)  cmd_user_ls "$@" ;;
    show)     cmd_user_show "$@" ;;
    new|add)  cmd_user_new "$@" ;;
    set)      cmd_user_set "$@" ;;
    disable)  cmd_user_gate disable "$@" ;;
    enable)   cmd_user_gate enable "$@" ;;
    member)   cmd_user_member "$@" ;;
    unmember) cmd_user_unmember "$@" ;;
    *) die "user: unknown subcommand '$sub' (ls|show|new|set|disable|enable|member|unmember)" ;;
  esac
}

