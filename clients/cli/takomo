  local id="" node=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --node) node=$2; shift 2 ;;
      -*) die "mindmap show: unknown flag $1" ;;
      *) if [ -z "$id" ]; then id=$1; shift; else die "mindmap show: unexpected argument '$1'"; fi ;;
    esac
  done
  [ -n "$id" ] || die "mindmap show: ID is required"
  api GET "/v1/mindmaps/$(urlenc "$id")" >/dev/null
  python3 - "$REQ_OUT" "$node" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
want = sys.argv[2] if len(sys.argv) > 2 else ""
m = d.get("mindmap", {})
nodes = d.get("nodes", [])
kids = {}
for n in nodes:
    kids.setdefault(n.get("parent"), []).append(n)

print(f"# {m.get('title')}   ({m.get('id')}, {m.get('status')})")

def line(n, depth):
    # The id sits beside the text because the next thing anyone does is hang a
    # thought under one of these, and that takes an id.
    promoted = n.get("promoted") or {}
    badge = f"  -> {promoted['kind']} {promoted['id']}" if promoted else ""
    print(f"{'  ' * depth}- {n.get('text','')}   [{n.get('id')}]{badge}")

def walk(parent, depth):
    for n in kids.get(parent, []):
        line(n, depth)
        walk(n.get("id"), depth + 1)

if want:
    one = next((n for n in nodes if n.get("id") == want), None)
    if not one:
        print(f"(no node {want} on this map)")
        sys.exit(1)
    line(one, 0)
    walk(want, 1)
else:
    walk(None, 0)
    if not nodes:
        print(f'(empty; add a thought with: takomo mindmap add {m.get("id")} "…")')
PY
}

