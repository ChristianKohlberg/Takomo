# Consulted by api() when a transition failed ambiguously. A blind replay is no
# use here: the store has no X -> X edge, so a repeat 409s `transition.illegal`
# whether or not the first attempt landed. Ask it what happened instead.
#   already at the target -> 0, with the ticket left in $REQ_OUT (same shape the
#                            transition itself returns, so the caller reads on)
#   still elsewhere       -> 10, replaying is safe and is exactly what was asked
#   cannot tell           -> 1, and api() fails loudly
CONFIRM_TICKET=""
CONFIRM_TARGET=""
confirm_transition() {
  local state
  http_request GET "/v1/tickets/$(urlenc "$CONFIRM_TICKET")" "" "" safe
  if [ -n "$REQ_FAIL" ] || [ "$REQ_CODE" != 200 ]; then
    warn "could not re-read $CONFIRM_TICKET to find out"
    return 1
  fi
  state=$(ticket_field state)
  if [ "$state" = "$CONFIRM_TARGET" ]; then
    warn "it did land — $CONFIRM_TICKET is already '$CONFIRM_TARGET'"
    return 0
  fi
  warn "it did not land — $CONFIRM_TICKET is still '$state'; replaying the move"
  return 10
}

# transition ID TO_STATE — auto-echoes the stored fence; clears it on terminal.
do_transition() {
  local id=$1 to=$2 reason=${3:-} fence
  fence=$(fence_load "$id")
  local data; data=$(TS_TO="$to" TS_REASON="$reason" TS_FENCE="$fence" python3 <<'PY'
import json, os
d = {"to": os.environ["TS_TO"]}
if os.environ.get("TS_REASON",""): d["reason"] = os.environ["TS_REASON"]
if os.environ.get("TS_FENCE",""): d["fence"] = int(os.environ["TS_FENCE"])
print(json.dumps(d))
PY
)
  CONFIRM_TICKET=$id; CONFIRM_TARGET=$to
  api POST "/v1/tickets/$(urlenc "$id")/transition" "$data" "" confirm_transition >/dev/null
  local newstate; newstate=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["state"])' "$REQ_OUT")
  case "$newstate" in done|cancelled) fence_clear "$id" ;; esac
  # If the server auto-released the claim on this move, drop the local fence too.
  python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if d.get("claim") else 1)' "$REQ_OUT" \
    || fence_clear "$id"
  echo "$id -> $newstate"
}

# --- workflow-aware state resolution -----------------------------------------
# The convenience verbs (start / done / block / cancel) must work across
# different workflows: `simple` uses in_progress/blocked/done, `factory-default`
# uses implementing/needs-decision/done. Rather than hard-coding state ids, we
# read the project's workflow and resolve the target by *category*, among the
# transitions actually legal from the ticket's current state. This mirrors the
# MCP server's targetsInCategory()/advanceToCategory() resolution (clients/mcp).

# Fetch a project's workflow into $2 (a file path) so later api calls overwriting
# $REQ_OUT do not clobber it.
wf_fetch() {
  local project=$1 dest=$2
  api GET "/v1/projects/$(urlenc "$project")/workflow" >/dev/null
  cp "$REQ_OUT" "$dest"
}

# Echo one field of a workflow state (e.g. category, claimable). Booleans print
# lowercased; a missing state or field prints the empty string.
wf_state_field() {
  local wf_file=$1 state=$2 field=$3
  TS_S="$state" TS_F="$field" python3 - "$wf_file" <<'PY'
import json, os, sys
wf = json.load(open(sys.argv[1]))
s = next((x for x in wf.get("states", []) if x.get("id") == os.environ["TS_S"]), {})
v = s.get(os.environ["TS_F"])
print("" if v is None else (str(v).lower() if isinstance(v, bool) else str(v)))
PY
}

# Resolve the single workflow state in $category reachable from $from. Echoes the
# target id and exits 0 on success; on an absent or ambiguous category it prints
# a message listing the legal moves and exits nonzero, so callers can die cleanly
# rather than guessing.
wf_resolve_target() {
  local wf_file=$1 from=$2 category=$3
  TS_FROM="$from" TS_CAT="$category" python3 - "$wf_file" <<'PY'
import json, os, sys
wf = json.load(open(sys.argv[1]))
frm, cat = os.environ["TS_FROM"], os.environ["TS_CAT"]
by_id = {s.get("id"): s for s in wf.get("states", [])}
legal = [t for t in wf.get("transitions", []) if t.get("from") == frm]
seen = []
for t in legal:
    to = t.get("to")
    if by_id.get(to, {}).get("category") == cat and to not in seen:
        seen.append(to)
if len(seen) == 1:
    print(seen[0]); sys.exit(0)
def fmt(t):
    r = t.get("requires")
    return t["to"] + (" (requires %s)" % ",".join(r) if r else "")
moves = ", ".join(fmt(t) for t in legal) or "(none)"
name = wf.get("name", "?")
if not seen:
    print("no move to a '%s' state from '%s' in workflow '%s'; legal moves: %s"
          % (cat, frm, name, moves))
else:
    print("ambiguous '%s' targets from '%s' (%s); use 'takomo move ID STATE'; legal moves: %s"
          % (cat, frm, ", ".join(seen), moves))
sys.exit(1)
PY
}

# Read one field from the ticket body currently in $REQ_OUT.
ticket_field() {
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' "$REQ_OUT" "$1"
}

cmd_start() {
  local id=${1:-}; [ -n "$id" ] || die "start: ID is required"
  api GET "/v1/tickets/$(urlenc "$id")" >/dev/null
  # Keep this response: it carries the project's style/language hints, and every
  # later call (workflow, claim, transition) overwrites $REQ_OUT.
  local conv_file; conv_file=$(mktemp); cp "$REQ_OUT" "$conv_file"
  local state project; state=$(ticket_field state); project=$(ticket_field project)
  local wf_file; wf_file=$(mktemp)
  wf_fetch "$project" "$wf_file"
  if [ "$(wf_state_field "$wf_file" "$state" category)" = "in_progress" ]; then
    rm -f "$wf_file"; echo "$id already in progress ($state)"
    print_conventions "$conv_file"; rm -f "$conv_file"; return
  fi
  # Claim first when the current state is claimable and we do not already hold it.
  if [ -z "$(fence_load "$id")" ] && [ "$(wf_state_field "$wf_file" "$state" claimable)" = "true" ]; then
    api POST "/v1/tickets/$(urlenc "$id")/claim" '{}' >/dev/null
    local fence; fence=$(save_fence_from_response "$id")
    echo "claimed $id  (fence $fence saved)"
  fi
  local target
  if ! target=$(wf_resolve_target "$wf_file" "$state" in_progress); then
    rm -f "$wf_file" "$conv_file"; die "start: $target"
  fi
  rm -f "$wf_file"
  do_transition "$id" "$target"
  print_conventions "$conv_file"; rm -f "$conv_file"
}

# done / block / cancel — resolve the terminal/blocked target from the ticket's
# current state in its project workflow, instead of assuming a fixed state id.
category_move() {
  local verb=$1 category=$2 id=${3:-}
  [ -n "$id" ] || die "$verb: ID is required"
  api GET "/v1/tickets/$(urlenc "$id")" >/dev/null
  local state project; state=$(ticket_field state); project=$(ticket_field project)
  local wf_file; wf_file=$(mktemp)
  wf_fetch "$project" "$wf_file"
  local target
  if ! target=$(wf_resolve_target "$wf_file" "$state" "$category"); then
    rm -f "$wf_file"; die "$verb: $target"
  fi
  rm -f "$wf_file"
  do_transition "$id" "$target"
}

cmd_done()   { category_move "done" "done" "${1:-}"; }
cmd_block()  { category_move "block" "blocked" "${1:-}"; }
cmd_cancel() { category_move "cancel" "cancelled" "${1:-}"; }
cmd_move() {
  local id=${1:-} to=${2:-}
  { [ -n "$id" ] && [ -n "$to" ]; } || die "move: usage: takomo move ID STATE"
  do_transition "$id" "$to"
}

cmd_comment() {
  local id=${1:-} text=${2:-}
  { [ -n "$id" ] && [ -n "$text" ]; } || die "comment: usage: takomo comment ID TEXT"
  local data; data=$(TS_B="$text" python3 -c 'import json,os; print(json.dumps({"body":os.environ["TS_B"]}))')
  api POST "/v1/tickets/$(urlenc "$id")/comments" "$data" >/dev/null
  echo "comment added to $id"
}

cmd_link() {
  local id=${1:-}; [ -n "$id" ] || die "link: ID is required"; shift
  local pr="" branch="" env="" run="" commit=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --pr)     pr=$2; shift 2 ;;
      --branch) branch=$2; shift 2 ;;
      --env)    env=$2; shift 2 ;;
      --run)    run=$2; shift 2 ;;
      --commit) commit=$2; shift 2 ;;
      *) die "link: unknown flag $1" ;;
    esac
  done
  [ -n "$pr$branch$env$run$commit" ] || die "link: give at least one of --pr --branch --env --run --commit"
  # A short SHA is ambiguous and the link is meant to be verifiable years later,
  # so nudge (not block — the value may legitimately be a commit URL).
  case "$commit" in
    "") ;;
    *://*) ;;
    *) [ ${#commit} -ge 40 ] || warn "link: '--commit $commit' looks like a short SHA; prefer the full 40-char SHA (or the commit URL) so it stays unambiguous" ;;
  esac
  # links is a whole-object replace; merge onto whatever is already there.
  api GET "/v1/tickets/$(urlenc "$id")" >/dev/null
  local fence; fence=$(fence_load "$id")
  local data; data=$(TS_FILE="$REQ_OUT" TS_PR="$pr" TS_BRANCH="$branch" TS_ENV="$env" \
    TS_RUN="$run" TS_COMMIT="$commit" TS_FENCE="$fence" python3 <<'PY'
import json, os
cur = json.load(open(os.environ["TS_FILE"]))
links = dict(cur.get("links") or {})
for env, key in (("TS_PR","pr"),("TS_BRANCH","branch"),("TS_ENV","env"),("TS_RUN","run"),("TS_COMMIT","commit")):
    v = os.environ.get(env, "")
    if v: links[key] = v
d = {"links": links}
if os.environ.get("TS_FENCE",""): d["fence"] = int(os.environ["TS_FENCE"])
print(json.dumps(d))
PY
)
  api PATCH "/v1/tickets/$(urlenc "$id")" "$data" >/dev/null
  echo "links updated on $id"
}

# tag: manage the project tag registry (person/component/team/… entities) and
# attach/detach `kind:handle` references on tickets. Reference metadata only —
# tagging never changes ticket state, claims, or question routing.
cmd_tag() {
  local sub=${1:-}
  [ -n "$sub" ] || die "tag: usage: takomo tag add|rm TICKET REF...  |  takomo tag ls|new|show|delete ..."
  shift
  case "$sub" in
    add)          cmd_tag_ticket tags_add "$@" ;;
    rm|remove)    cmd_tag_ticket tags_remove "$@" ;;
    ls|list)      cmd_tag_ls "$@" ;;
    new|register) cmd_tag_new "$@" ;;
    show)         cmd_tag_show "$@" ;;
    delete|del)   cmd_tag_delete "$@" ;;
    *) die "tag: unknown subcommand '$sub' (add|rm|ls|new|show|delete)" ;;
  esac
}

cmd_tag_ticket() {
  local key=$1; shift
  local id=${1:-}; [ -n "$id" ] || die "tag: TICKET is required (e.g. takomo tag add rvp-x7k2 person:ada)"; shift
  local -a refs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) die "tag: unknown flag $1" ;;
      *) refs+=("$1"); shift ;;
    esac
  done
  [ ${#refs[@]} -gt 0 ] || die "tag: give at least one kind:handle ref (e.g. person:ada)"
  local fence; fence=$(fence_load "$id")
  local data; data=$(TS_KEY="$key" TS_FENCE="$fence" \
    TS_REFS="$(printf '%s\n' "${refs[@]}")" python3 <<'PY'
import json, os
refs = [r for r in os.environ["TS_REFS"].splitlines() if r.strip()]
d = {os.environ["TS_KEY"]: refs}
if os.environ.get("TS_FENCE",""): d["fence"] = int(os.environ["TS_FENCE"])
print(json.dumps(d))
PY
)
  api PATCH "/v1/tickets/$(urlenc "$id")" "$data" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
tags = d.get("tags") or []
print(f"{d['id']} tags: " + (" ".join('#'+t for t in tags) if tags else "(none)"))
PY
}

cmd_tag_ls() {
  local project="" kind="" q=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project=$2; shift 2 ;;
      --kind) kind=$2; shift 2 ;;
      -q|--query) q=$2; shift 2 ;;
      -*) die "tag ls: unknown flag $1" ;;
      *) die "tag ls: unexpected argument '$1'" ;;
    esac
  done
  project=$(resolve_project "$project")
  local qs="" sep="?"
