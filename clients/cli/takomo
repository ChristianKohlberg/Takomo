#!/usr/bin/env bash
# takomo — a friendly command-line client for the takomo.
#
# A single self-contained wrapper over the REST API so a human or an agent can
# work the queue without hand-writing curl. It is the beads/beans-equivalent
# surface for the takomo: create, search, claim, and progress tickets.
#
# Transport is curl (its default User-Agent sails past WAFs that block the
# python-urllib default UA). python3 is used only locally, to build request
# bodies and format responses — never to make the HTTP request itself.
#
# Environment:
#   TAKOMO_URL      required. The /v1 base, e.g. https://host/v1
#   TAKOMO_TOKEN    required. A read/write (and, for gated moves, human) token.
#   TAKOMO_PROJECT  optional. Default project when --project is omitted.
#   TAKOMO_ACTOR    optional. Your actor name; only needed for `ls --mine`.
#   TAKOMO_RETRIES  optional. Extra attempts after a transient gateway failure
#                   (502/503/504 or an unreachable host). Default 3; 0 disables.
#   TAKOMO_RETRY_MAX_SECONDS
#                   optional. Total budget for backoff waits. Default 20.
#
# Requests that are not safe to send twice (a comment would double-post, a token
# mint would issue a second credential) are never replayed; they fail loudly
# instead, telling you to check before re-running. See replay_class().
#
# Repo-local config: after `takomo init`, url/project/token are read from a
# `.takomo/` directory (walking up from the cwd) so plain `takomo new`/`takomo ready`
# just work inside that repo. Precedence is explicit flag > environment >
# `.takomo` config.
#
# The fence for a claimed ticket is remembered locally (keyed by store URL +
# ticket id) so start/done/comment/link "just work" after a claim without you
# passing --fence. Override or supply it explicitly with --fence N.
#
# Dependencies: bash, curl, python3 (stdlib only; PyYAML only if you pass a
# custom .yaml workflow to `takomo init`).
set -euo pipefail

PROG=takomo
die() { echo "$PROG: $*" >&2; exit 2; }
warn() { echo "$PROG: $*" >&2; }

# --- repo-local config (.takomo) -----------------------------------------
# Walk up from the cwd for a `.takomo/config` (KEY=VALUE) and `.takomo/token`.
# Only fills TAKOMO_URL/PROJECT/TOKEN that are not already set in the
# environment, so env (and thus any explicit override) always wins.
load_takomo_config() {
  local dir="$PWD" cfg="" tok=""
  while [ -n "$dir" ]; do
    if [ -f "$dir/.takomo/config" ]; then cfg="$dir/.takomo/config"; tok="$dir/.takomo/token"; break; fi
    [ "$dir" = "/" ] && break
    dir=$(dirname "$dir")
  done
  [ -n "$cfg" ] || return 0
  local url proj
  url=$(sed -n 's/^url=//p' "$cfg" | tail -1)
  proj=$(sed -n 's/^project=//p' "$cfg" | tail -1)
  [ -z "${TAKOMO_URL:-}" ] && [ -n "$url" ] && export TAKOMO_URL="$url"
  [ -z "${TAKOMO_PROJECT:-}" ] && [ -n "$proj" ] && export TAKOMO_PROJECT="$proj"
  if [ -z "${TAKOMO_TOKEN:-}" ] && [ -f "$tok" ]; then
    TAKOMO_TOKEN="$(cat "$tok")"
    export TAKOMO_TOKEN
  fi
}

# --- local fence store -------------------------------------------------------
fence_dir() {
  local base="${XDG_STATE_HOME:-$HOME/.local/state}/takomo/fences"
  if mkdir -p "$base" 2>/dev/null; then echo "$base"; return; fi
  base="/tmp/takomo-${UID:-$(id -u)}/fences"
  mkdir -p "$base"
  echo "$base"
}
fence_file() {
  local id=$1 urlkey
  urlkey=$(printf '%s' "${TAKOMO_URL:-}" | cksum | cut -d' ' -f1)
  echo "$(fence_dir)/${urlkey}_${id}"
}
fence_save() { printf '%s' "$2" > "$(fence_file "$1")"; }
fence_load() { local f; f=$(fence_file "$1"); if [ -f "$f" ]; then cat "$f"; fi; }
fence_clear() { rm -f "$(fence_file "$1")" 2>/dev/null || true; }

# --- HTTP --------------------------------------------------------------------
REQ_OUT=$(mktemp)
trap 'rm -f "$REQ_OUT"' EXIT

# The command line as invoked, so an unconfirmed write can print exactly what
# to re-run. Filled in by main().
CMD_ARGV=()
argv_str() {
  local a out=$PROG
  if [ ${#CMD_ARGV[@]} -gt 0 ]; then
    for a in "${CMD_ARGV[@]}"; do
      case "$a" in
        ""|*[!A-Za-z0-9_/.:@=-]*) out="$out $(printf '%q' "$a")" ;;
        *) out="$out $a" ;;
      esac
    done
  fi
  printf '%s' "$out"
}

# --- retry -------------------------------------------------------------------
# The failure this guards against: a proxy in front of the store answers 502 for
# a few seconds while /healthz stays green and the store itself is healthy. One
# request per command means the `comment` carrying a ticket's only proof of
# verification, or the `link --commit` closing the loop on a merged change, is
# dropped on the floor — and because the 502 body is a fat HTML page from the
# proxy, the failure does not even look like an error.
#
#   TAKOMO_RETRIES            extra attempts after the first (default 3; 0 disables)
#   TAKOMO_RETRY_MAX_SECONDS  wall-clock budget for all backoff waits (default 20)
#
# Waits are exponential with full jitter over the top half of each window
# (~0.2-0.4s, 0.4-0.8s, 0.8-1.6s, …, capped at 8s) so a fleet that all hit the
# same blip does not come back in lockstep and finish off a struggling server.
RETRY_BASE_MS=400
RETRY_CAP_MS=8000

# HTTP statuses that mean "the infrastructure between you and the store failed",
# not "the store rejected your request". A 500 is deliberately absent: it comes
# from takomo itself, which means the request arrived and the transaction rolled
# back, and repeating it just delays a real error.
is_transient_status() { case "$1" in 502|503|504) return 0 ;; *) return 1 ;; esac; }

# curl exit codes that prove the request never left the machine: 5 (proxy host
# unresolved), 6 (host unresolved), 7 (connect failed). Nothing can have been
# applied, so these are replayable for *every* verb — even the ones an
# ambiguous 502 must never replay.
curl_never_sent() { case "$1" in 5|6|7) return 0 ;; *) return 1 ;; esac; }

# replay_class METHOD PATH [EXTRA_HEADER] -> "safe" | "unsafe"
#
# A 502 is ambiguous: the request may have reached the store and been applied,
# or it may never have arrived. "safe" means strictly that sending it twice
# leaves the store exactly where sending it once does, so replaying an ambiguous
# failure cannot double anything. Every entry below was checked against the
# store's actual behaviour, not assumed.
#
# safe:
#   GET                            reads
#   PUT /v1/projects/*             whole-value replace (workflow, style, language)
#   PATCH /v1/tickets/*            links, tags_add/tags_remove, labels, parent are
#                                  all set-to-value, not accumulate. A `body`
#                                  patch is the exception — it needs If-Match and
#                                  a replay would 409 on the bumped version — so
#                                  any If-Match request is excluded below.
#   POST /v1/tickets               `takomo new` sends an Idempotency-Key and the
#                                  store returns the original ticket (200, not a
#                                  twin 201) for a repeat.
#   POST .../claim                 same actor re-claiming is an idempotent lease
#                                  renewal: same fence back, 200. (Only a
#                                  *different* holder gets 409.)
#   POST .../archive, .../unarchive  no-op when already in that state.
#   POST .../deps                  INSERT OR IGNORE; re-adding an edge is a no-op.
#   POST /v1/questions             the store dedupes an identical still-open
#                                  question (ticket+asker+mode+kind+title) and
#                                  returns the first one instead of filing a
#                                  second. `takomo ask` always sends a title, so
#                                  the dedup key is fully determined here.
#   DELETE .../deps, /v1/shares/*, /v1/answer-links/*
#                                  the store treats a repeat as success.
#
# unsafe — never replayed automatically; these fail loudly instead:
#   POST .../comments              was unconditional before idempotency keys;
#                                  still unsafe without Idempotency-Key.
#   POST /v1/tokens, /v1/shares    would mint a second live credential whose
#                                  one-time plaintext you never saw.
#   POST /v1/ready/claim           would leak a lease on ticket A and hand you B.
#   POST .../promote               append-only history; would duplicate the row.
#   POST .../release               replay 409s `claim.none`.
#   POST /v1/questions/*/…         answer/withdraw/reopen/reply/options replay
#                                  into a 409 or a duplicate thread message.
#   DELETE /v1/tokens/*, /v1/projects/*
#                                  a replay 404s, which reads as "wrong id"
#                                  rather than "the first one landed".
#   POST .../transition            replay 409s `transition.illegal` (X -> X is
#                                  not an edge). Recovered instead by asking the
#                                  store what happened — see confirm_transition.
replay_class() {
  local method=$1 path=$2 extra=${3:-}
  # A conditional write is never replayable: the first attempt moved the version
  # the second one is matching against.
  case "$extra" in If-Match:*) echo unsafe; return ;; esac
  case "$method" in
    GET|HEAD) echo safe; return ;;
    PUT) case "$path" in /v1/projects/*) echo safe; return ;; esac ;;
    PATCH) case "$path" in /v1/tickets/*) echo safe; return ;; esac ;;
    DELETE)
      case "$path" in
        /v1/tickets/*/deps*|/v1/shares/*|/v1/answer-links/*) echo safe; return ;;
      esac
      ;;
    POST)
      case "$path" in
        /v1/tickets) case "$extra" in Idempotency-Key:*) echo safe; return ;; esac ;;
        /v1/tickets/*/comments) case "$extra" in Idempotency-Key:*) echo safe; return ;; esac ;;
        /v1/questions) echo safe; return ;;
        /v1/tickets/*/claim|/v1/tickets/*/archive|/v1/tickets/*/unarchive|/v1/tickets/*/deps)
          echo safe; return ;;
      esac
      ;;
  esac
  echo unsafe
}

# Outcome of the last http_request. Globals rather than stdout because api()
# needs the failure kind as well as the status, and a $(…) subshell would throw
# it away.
REQ_CODE=000
REQ_ATTEMPTS=0
REQ_FAIL=""   # "" ok | transient (5xx/mid-flight) | unreachable (never sent) | refused (unsafe to replay)

# http_request METHOD PATH DATA EXTRA REPLAY_CLASS
# One request with bounded, jittered retry. The body lands in $REQ_OUT and the
# HTTP status in $REQ_CODE ("000" when curl itself failed). Never exits.
http_request() {
  local method=$1 path=$2 data=${3:-} extra=${4:-} replay=${5:-unsafe}
  local -a args=(-sS -o "$REQ_OUT" -w '%{http_code}' -X "$method"
    "$TAKOMO_URL$path" -H "Authorization: Bearer $TAKOMO_TOKEN")
  [ -n "$extra" ] && args+=(-H "$extra")
  if [ -n "$data" ]; then
    args+=(-H "Content-Type: application/json" --data-binary "$data")
  fi

  local max=${TAKOMO_RETRIES:-3} budget=${TAKOMO_RETRY_MAX_SECONDS:-20}
  local start now rc kind window wait_ms secs seen shift_by
  start=$(date +%s)
  REQ_ATTEMPTS=0
  REQ_FAIL=""
  while :; do
    REQ_ATTEMPTS=$((REQ_ATTEMPTS + 1))
    rc=0
    REQ_CODE=$(curl "${args[@]}") || rc=$?
    if [ "$rc" -eq 0 ]; then
      is_transient_status "$REQ_CODE" || { REQ_FAIL=""; return 0; }
      kind=transient
      seen="HTTP $REQ_CODE"
    else
      REQ_CODE=000
      if curl_never_sent "$rc"; then kind=unreachable; else kind=transient; fi
      seen="unreachable (curl exit $rc)"
    fi
    REQ_FAIL=$kind
    # An ambiguous failure — a 5xx, or a transport error after the bytes went
    # out — must not be replayed for a write that is not safe to repeat.
    if [ "$kind" != unreachable ] && [ "$replay" != safe ]; then
      REQ_FAIL=refused
      return 0
    fi
    [ "$REQ_ATTEMPTS" -gt "$max" ] && return 0
    shift_by=$((REQ_ATTEMPTS - 1)); [ "$shift_by" -gt 16 ] && shift_by=16
    window=$((RETRY_BASE_MS << shift_by))
    [ "$window" -gt "$RETRY_CAP_MS" ] && window=$RETRY_CAP_MS
    wait_ms=$((window / 2 + RANDOM % (window / 2 + 1)))
    now=$(date +%s)
    [ $(((now - start) * 1000 + wait_ms)) -gt $((budget * 1000)) ] && return 0
    secs=$(printf '%d.%03d' $((wait_ms / 1000)) $((wait_ms % 1000)))
    warn "$method $path -> $seen; retrying in ${secs}s (attempt $((REQ_ATTEMPTS + 1))/$((max + 1)))"
    sleep "$secs"
  done
}

# Render whatever is in $REQ_OUT as an error. A takomo error is JSON and gets
# its teaching fields printed; anything else (a proxy's HTML 502 page, a WAF
# interstitial) is *summarised*, never dumped — dumping it is what buried the
# failure in a screenful of base64 font data.
render_http_error() {
  local code=$1 indent=${2:-}
  python3 - "$REQ_OUT" "$code" "$indent" >&2 <<'PY'
import json, re, sys
tmp, code, ind = sys.argv[1], sys.argv[2], sys.argv[3]
raw = open(tmp, "rb").read()
try:
    d = json.loads(raw)
    if not isinstance(d, dict):
        raise ValueError
except Exception:
    d = None
if d is None:
    text = raw.decode("utf-8", "replace")
    m = re.search(r"<title[^>]*>(.*?)</title>", text, re.S | re.I)
    gist = m.group(1) if m else re.sub(r"(?s)<[^>]+>", " ", re.sub(
        r"(?is)<(script|style)[^>]*>.*?</\1>", " ", text))
    gist = " ".join(gist.split())[:100] or "(empty body)"
    print(f"{ind}HTTP {code} — not a takomo error: {len(raw)} bytes of non-JSON "
          f"from something in front of the store")
    print(f'{ind}gateway said: "{gist}"')
    sys.exit()
print(f"{ind}HTTP {code}  [{d.get('code','?')}]")
if d.get('message'): print(ind + d['message'])
if d.get('remedy'):  print(ind + "remedy: " + d['remedy'])
if d.get('current_state'): print(ind + "current state: " + d['current_state'])
for t in d.get('allowed_transitions', []):
    req = (" (requires " + ", ".join(t['requires']) + ")") if t.get('requires') else ""
    print(f"{ind}  allowed -> {t['to']}{req}")
PY
}

# Abort on a transient failure the retries could not get past. Loud on purpose:
# every line is prefixed, nothing goes to stdout, and the last line — the one
# that survives `2>&1 | tail -1` — says what to do next.
die_transient() {
  local method=$1 path=$2 gave_up
  echo "$PROG: ===== REQUEST FAILED — THIS IS NOT A TAKOMO ERROR =====" >&2
  if [ "$REQ_CODE" = "000" ]; then
    echo "$PROG: could not reach the store at $TAKOMO_URL" >&2
  else
    render_http_error "$REQ_CODE" "$PROG: "
  fi
  echo "$PROG: request was: $method $path" >&2
  gave_up="gave up after $REQ_ATTEMPTS attempt(s)"
  [ "$REQ_FAIL" = refused ] && gave_up="$gave_up — not retried, because repeating this request could apply it twice"
  echo "$PROG: $gave_up" >&2
  case "$method:$REQ_FAIL" in
    GET:*|HEAD:*)
      echo "$PROG: >>> Nothing was read. Re-run: $(argv_str)" >&2 ;;
    *:unreachable)
      # The connection was never established, so the store cannot have seen it.
      echo "$PROG: THE WRITE DID NOT HAPPEN — the store was never reached." >&2
      echo "$PROG: >>> Safe to re-run as-is: $(argv_str)" >&2 ;;
    *)
      echo "$PROG: THE WRITE WAS NOT CONFIRMED — it may have been applied, or not." >&2
      echo "$PROG: >>> Check whether it landed BEFORE re-running: $(argv_str)" >&2 ;;
  esac
  exit 1
}

# api METHOD PATH [JSON_DATA] [EXTRA_HEADER] [CONFIRM_FN]
# Writes the raw body to $REQ_OUT and echoes the HTTP status code on stdout.
# On any >=400 it prints the store's teaching error (code/message/remedy/
# allowed_transitions) to stderr and exits nonzero, so callers never have to
# guard against error bodies. Transient gateway failures are retried per
# replay_class; what survives that is fatal and unmistakable.
#
# CONFIRM_FN, when given, rescues a write that is unsafe to replay blind: after
# an ambiguous failure it is called to ask the store what actually happened. It
# must exit 0 ("already applied — $REQ_OUT now holds an equivalent response"),
# 10 ("not applied — replaying is safe"), or anything else ("cannot tell").
api() {
  local method=$1 path=$2 data=${3:-} extra=${4:-} confirm=${5:-} cls rc
  cls=$(replay_class "$method" "$path" "$extra")
  http_request "$method" "$path" "$data" "$extra" "$cls"
  if [ -n "$REQ_FAIL" ] && [ -n "$confirm" ]; then
    warn "$method $path did not complete; asking the store whether it landed"
    rc=0; "$confirm" || rc=$?
    case "$rc" in
      0)  REQ_FAIL=""; echo 200; return 0 ;;
      10) http_request "$method" "$path" "$data" "$extra" safe ;;
    esac
  fi
  [ -n "$REQ_FAIL" ] && die_transient "$method" "$path"
  if [ "$REQ_CODE" -ge 400 ]; then
    render_http_error "$REQ_CODE"
    exit 1
  fi
  echo "$REQ_CODE"
}

# Like api(), but never exits on an error status — returns the HTTP code on
# stdout (or "000" on a curl failure) and leaves the body in $REQ_OUT. Used by
# the importer's best-effort relation/state passes, where one item failing must
# not abort the whole run. Retries on the same terms as api().
api_try() {
  local method=$1 path=$2 data=${3:-} extra=${4:-} cls
  cls=$(replay_class "$method" "$path" "$extra")
  http_request "$method" "$path" "$data" "$extra" "$cls"
  echo "$REQ_CODE"
}

# Print the store's teaching message from the last $REQ_OUT body to stderr,
# indented, for the importer's soft failures.
print_api_error() { render_http_error "${1:-?}" "    "; }

require_env() {
  load_takomo_config
  [ -n "${TAKOMO_URL:-}" ]   || die "TAKOMO_URL is not set (e.g. https://host or https://host/v1). Run 'takomo init' in a git repo, or export it."
  [ -n "${TAKOMO_TOKEN:-}" ] || die "TAKOMO_TOKEN is not set. Run 'takomo init', or export a token."
  # Normalize to the host root: paths below always carry their own /v1, so we
  # accept TAKOMO_URL with or without a trailing /v1 (and trailing slash).
  TAKOMO_URL="${TAKOMO_URL%/}"
  TAKOMO_URL="${TAKOMO_URL%/v1}"
}

resolve_project() {
  local p=${1:-}
  [ -n "$p" ] && { echo "$p"; return; }
  [ -n "${TAKOMO_PROJECT:-}" ] && { echo "$TAKOMO_PROJECT"; return; }
  die "no project given; pass --project P or set TAKOMO_PROJECT"
}

# urlencode a single query value
urlenc() { python3 -c 'import sys,urllib.parse as u; print(u.quote(sys.argv[1], safe=""))' "$1"; }
# A page size must be a positive integer. Checked here rather than left to the
# server so `--limit abc` fails naming the flag, instead of coming back as a
# validation error about a query parameter the caller never typed.
is_uint() { case "$1" in ''|*[!0-9]*) return 1 ;; 0) return 1 ;; *) return 0 ;; esac; }

# Parse a link lifetime — 24h, 7d, 90m, 3600s, or a plain second count — into
# seconds. One parser behind every --ttl the CLI takes (share, answer-link,
# project answer-ttl), so a duration reads the same wherever it is typed.
# `die` exits the command substitution's subshell, so call sites need `|| exit 1`.
ttl_to_seconds() {
  local raw=${1:-} mult=1 num=${1:-}
  case "$raw" in
    *d) mult=86400; num=${raw%d} ;;
    *h) mult=3600;  num=${raw%h} ;;
    *m) mult=60;    num=${raw%m} ;;
    *s) mult=1;     num=${raw%s} ;;
  esac
  case "$num" in
    ''|*[!0-9]*) die "invalid ttl '$raw': use 24h, 7d, 90m, 3600s, or a plain second count" ;;
  esac
  echo $(( num * mult ))
}

# Print the project's writing conventions carried by a work-loop response — the
# `style_hint` / `language_hint` the store attaches to new/show/claim/next/start.
# The CLI never dumps raw JSON, so without this the hints would arrive on the
# wire and never reach the agent reading the terminal.
#
# Reads $1 (a response body file; defaults to the last $REQ_OUT) and prints
# nothing at all when the project sets no conventions.
print_conventions() {
  python3 - "${1:-$REQ_OUT}" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
if not isinstance(d, dict):
    sys.exit(0)
style = (d.get("style_hint") or {}).get("style_guide")
lang = (d.get("language_hint") or {}).get("question_language")
if style:
    print("\nstyle guide (this project's house style — follow it as written):")
    for line in style.splitlines():
        print("  " + line)
if lang:
    print(f"\nquestion language: {lang}  (human-facing questions and their options)")
PY
}

# --- commands ----------------------------------------------------------------

cmd_new() {
  local project="" type="" priority="" parent="" body=""
  local -a labels=()
  local -a tags=()
  local title=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project=$2; shift 2 ;;
      --type)    type=$2; shift 2 ;;
      --priority) priority=$2; shift 2 ;;
      --parent)  parent=$2; shift 2 ;;
      --body)    body=$2; shift 2 ;;
      --label)   labels+=("$2"); shift 2 ;;
      --tag)     tags+=("$2"); shift 2 ;;
      --) shift; break ;;
      -*) die "new: unknown flag $1" ;;
      *) title=$1; shift ;;
    esac
  done
  [ -n "$title" ] || die "new: TITLE is required"
  project=$(resolve_project "$project")
  # One key per invocation, so a retry inside this command replays the original
  # ticket instead of creating a twin. $$ keeps two agents that fire in the same
  # second from colliding on $RANDOM.
  local idem; idem="takomo-cli-$(date +%s)-$$-$RANDOM"
  local data
  data=$(TS_PROJECT="$project" TS_TYPE="$type" TS_TITLE="$title" TS_BODY="$body" \
    TS_PRIORITY="$priority" TS_PARENT="$parent" \
    TS_LABELS="$(printf '%s\n' "${labels[@]+"${labels[@]}"}")" \
    TS_TAGS="$(printf '%s\n' "${tags[@]+"${tags[@]}"}")" python3 <<'PY'
import json, os
d = {"project": os.environ["TS_PROJECT"], "title": os.environ["TS_TITLE"]}
for env, key in (("TS_TYPE","type"),("TS_PRIORITY","priority"),("TS_PARENT","parent")):
    v = os.environ.get(env, "").strip()
    if v: d[key] = v
if os.environ.get("TS_BODY", ""): d["body"] = os.environ["TS_BODY"]
labels = [l for l in os.environ.get("TS_LABELS","").splitlines() if l.strip()]
if labels: d["labels"] = labels
tags = [t for t in os.environ.get("TS_TAGS","").splitlines() if t.strip()]
if tags: d["tags"] = tags
print(json.dumps(d))
PY
)
  api POST /v1/tickets "$data" "Idempotency-Key: $idem" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
print(f"created {d['id']}  [{d['state']}]  {d['title']}")
sim = d.get("similar") or []
if sim:
    print("\npossible duplicates (search before creating):")
    for s in sim:
        print(f"  {s.get('id')}  [{s.get('state','?')}]  {s.get('title','')}")
PY
  print_conventions
}

cmd_ls() {
  local project="" state="" q="" mine="" archived="" limit="100" cursor="" epic=""
  local -a labels=()
  local -a tags=()
  local -a tag_kinds=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project=$2; shift 2 ;;
      --state)   state=$2; shift 2 ;;
      --epic)    epic=$2; shift 2 ;;
      --label)   labels+=("$2"); shift 2 ;;
      --tag)     tags+=("$2"); shift 2 ;;
      --tag-kind) tag_kinds+=("$2"); shift 2 ;;
      --mine)    mine=1; shift ;;
      --archived) archived=1; shift ;;
      --limit)   limit=$2; shift 2 ;;
      --cursor)  cursor=$2; shift 2 ;;
      -q|--query) q=$2; shift 2 ;;
      -*) die "ls: unknown flag $1" ;;
      *) die "ls: unexpected argument '$1'" ;;
    esac
  done
  is_uint "$limit" || die "ls: --limit takes a positive integer, got '$limit'"
  local qs="?limit=$limit"
  [ -n "$cursor" ] && qs="$qs&cursor=$(urlenc "$cursor")"
  [ -n "$project" ] && qs="$qs&project=$(urlenc "$project")"
  [ -z "$project" ] && [ -n "${TAKOMO_PROJECT:-}" ] && qs="$qs&project=$(urlenc "$TAKOMO_PROJECT")"
