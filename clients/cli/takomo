cmd_roadmap() {
  local project="" epic=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project=$2; shift 2 ;;
      --epic) epic=$2; shift 2 ;;
      -*) die "roadmap: unknown flag $1" ;;
      *) die "roadmap: unexpected argument '$1'" ;;
    esac
  done
  project=$(resolve_project "$project")
  api GET "/v1/projects/$(urlenc "$project")/roadmap${epic:+?epic=$(urlenc "$epic")}" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
epics = d.get("epics", [])
print(f"roadmap for {d.get('project','')}  ({len(epics)} epic(s))")
def bar(pct, width=10):
    filled = int(round(pct / 100.0 * width))
    filled = max(0, min(width, filled))
    return "[" + "#" * filled + "-" * (width - filled) + "]"
def trunc(s, n): return s if len(s) <= n else s[:n-1] + "..."
def rollup(r, label="children by state", indent="  "):
    total = r.get("total", 0); done = r.get("done", 0); pct = r.get("percent", 0)
    print(f"{indent}{bar(pct)} {done}/{total} done  ({pct}%)")
    bs = r.get("by_state") or {}
    if bs:
        print(f"{indent}{label}: " + ", ".join(f"{k}={v}" for k, v in sorted(bs.items())))
    # The claimable half, split into what the queue would actually hand out and
    # what it would not. Printed only when there IS claimable work, so a
    # finished epic does not carry a line of zeroes.
    ready = r.get("ready", 0); backlog = r.get("backlog", 0)
    awaiting = r.get("awaiting_answer", 0)
    if ready or backlog or awaiting:
        parts = [f"ready={ready}", f"backlog={backlog}"]
        # An overlay on the counts above, not a bucket of its own — flagged with
        # `!` because a ticket waiting on an answer is not work anyone can pick
        # up, however claimable it looks.
        if awaiting:
            parts.append(f"!awaiting answer={awaiting}")
        print(f"{indent}claimable: " + ", ".join(parts))
if not epics:
    print("(no epics)")
for e in epics:
    flags = e.get("flags") or []
    suffix = "  !" + ",".join(flags) if flags else ""
    print(f"\n{e['id']}  [{e.get('state','')}]  {trunc(e.get('title',''), 52)}{suffix}")
    rollup(e)
# Work that belongs to no epic is real work: show it even when it is empty, so
# an empty bucket reads as "all accounted for" rather than as a missing row.
#
# Under --epic the server OMITS these project-wide sections rather than zeroing
# them, so key presence is the test. Printing "0 ticket(s) outside every epic"
# from a missing key would make exactly the false statement the omission avoids.
if "unparented" in d:
    print(f"\n(no epic)  {d['unparented'].get('total', 0)} ticket(s) outside every epic")
    rollup(d["unparented"], "tickets by state")
# The lane view: an epic closes, an initiative does not, so this is progress over
# the life of a feature rather than of one version. Totals may overlap between
# lanes and are deliberately not summed into a project figure.
if "initiatives" in d:
    lanes = d["initiatives"]
    print(f"\n--- initiatives  ({len(lanes)} lane(s)) ---")
    if not lanes:
        print("(none)")
    for lane in lanes:
        flags = lane.get("flags") or []
        suffix = "  !" + ",".join(flags) if flags else ""
        versions = lane.get("epics") or []
        vtxt = f"  {len(versions)} version(s)" if versions else ""
        title = trunc(lane.get("title", ""), 46)
        print(f"\n{lane['id']}  [{lane.get('status','')}]  {title}{vtxt}{suffix}")
        rollup(lane, "work by state")
    uninitiated = d.get("uninitiated") or {}
    print(f"\n(no initiative)  {uninitiated.get('total', 0)} ticket(s) outside every lane")
    rollup(uninitiated, "tickets by state")
PY
}

