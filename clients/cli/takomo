# --- token administration (admin scope) --------------------------------------

cmd_token() {
  local sub=${1:-}; [ -n "$sub" ] || die "token: usage: takomo token create|ls|revoke ..."
  shift
  case "$sub" in
    create) cmd_token_create "$@" ;;
    ls|list) cmd_token_ls "$@" ;;
    revoke) cmd_token_revoke "$@" ;;
    *) die "token: unknown subcommand '$sub' (create|ls|revoke)" ;;
  esac
}

cmd_token_create() {
  local actor="" scopes="read,write" projects="" expires=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --actor)    actor=$2; shift 2 ;;
      --scopes)   scopes=$2; shift 2 ;;
      --projects) projects=$2; shift 2 ;;
      --expires)  expires=$2; shift 2 ;;
      -*) die "token create: unknown flag $1" ;;
      *) die "token create: unexpected argument '$1'" ;;
    esac
  done
  [ -n "$actor" ] || die "token create: --actor NAME is required"
  local data
  data=$(TS_ACTOR="$actor" TS_SCOPES="$scopes" TS_PROJECTS="$projects" TS_EXPIRES="$expires" python3 <<'PY'
import json, os
d = {"actor": os.environ["TS_ACTOR"]}
d["scopes"] = [s for s in os.environ["TS_SCOPES"].split(",") if s.strip()]
proj = os.environ.get("TS_PROJECTS", "").strip()
if proj and proj != "*":
    d["projects"] = [p for p in proj.split(",") if p.strip()]
exp = os.environ.get("TS_EXPIRES", "").strip()
if exp:
    units = {"d": 86400, "h": 3600, "m": 60, "s": 1}
    if exp[-1] in units and exp[:-1].isdigit():
        d["expires_seconds"] = int(exp[:-1]) * units[exp[-1]]
    elif exp.isdigit():
        d["expires_seconds"] = int(exp)
    else:
        raise SystemExit(f"invalid --expires '{exp}': use 90d, 12h, 30m, 3600s, or a plain second count")
print(json.dumps(d))
PY
)
  api POST /v1/tokens "$data" >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
proj = d.get("projects")
proj = "*" if proj == "*" else ", ".join(proj) if isinstance(proj, list) else proj
print(f"token id:  {d.get('id','')}")
print(f"actor:     {d.get('actor','')}")
print(f"scopes:    {', '.join(d.get('scopes', []))}")
print(f"projects:  {proj}")
print(f"expires:   {d.get('expires_at') or 'never'}")
print(f"rate:      {d.get('rate_limit','?')}/min writes")
print()
print(d.get("token", ""))
print()
print(d.get("warning", "This plaintext is shown once; only its hash is stored."))
PY
}

cmd_token_ls() {
  api GET /v1/tokens >/dev/null
  python3 - "$REQ_OUT" <<'PY'
import json, sys, unicodedata
rows = json.load(open(sys.argv[1]))
if not rows:
    print("(no tokens)"); sys.exit()
def proj(p): return "*" if p == "*" else ",".join(p) if isinstance(p, list) else str(p)
BIDI = {chr(0x200e), chr(0x200f)} | {chr(c) for c in range(0x202a, 0x202f)} | {chr(c) for c in range(0x2066, 0x206a)}
def connection(t):
    c = t.get("oauth_client") or {}
    # `label` is what the server sanitizes for display; client_name/client_id are
    # the fallback for a server that predates it. Sanitize whichever we picked:
    # this name arrived through an UNAUTHENTICATED registration endpoint and a
    # terminal interprets escape sequences, so a forged row here could hide or
    # overwrite the row an operator is about to revoke.
    raw = (c.get("label") or c.get("client_name") or c.get("client_id") or "").strip()
    if not raw: return "-"
    return "".join("?" if unicodedata.category(ch) == "Cc" or ch in BIDI else ch for ch in raw)
# The CONNECTION column appears only when a row belongs to one. Most deployments
# have no OAuth tokens at all, and widening every row for a column that would be
# empty in all of them is a worse table.
conns = any(t.get("oauth_client") for t in rows)
head = f"{'ID':<14} {'ACTOR':<22} {'SCOPES':<20} {'PROJECTS':<12} {'REVOKED':<8}"
print(f"{head} {'LAST USED':<22} CONNECTION" if conns else f"{head} LAST USED")
for t in rows:
    row = (f"{t.get('id',''):<14} {t.get('actor',''):<22} {','.join(t.get('scopes',[])):<20} "
           f"{proj(t.get('projects')):<12} {('yes' if t.get('revoked_at') else 'no'):<8}")
    used = t.get('last_used_at') or 'never'
    print(f"{row} {used:<22} {connection(t)}" if conns else f"{row} {used}")
PY
}

cmd_token_revoke() {
  local id=${1:-}; [ -n "$id" ] || die "token revoke: ID is required"
  api DELETE "/v1/tokens/$(urlenc "$id")" >/dev/null
  echo "revoked $id"
}

